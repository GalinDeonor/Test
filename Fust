-- 0.39: УХУДШЕНИЕ ТЕКСТУР ДЛЯ FPS
TextureBackup = nil
function applyTextureDegradation(state)
pcall(function()
if state then
if not TextureBackup then
TextureBackup = {
MaterialService2022 = nil,
LightingTech = Lighting.Technology,
}
pcall(function()
local ms = game:GetService("MaterialService")
TextureBackup.MaterialService2022 = ms.Use2022Materials
ms.Use2022Materials = false
end)
end
-- всем BasePart в Workspace — Material = Plastic (если ещё не)
pcall(function()
for _, d in ipairs(Workspace:GetDescendants()) do
if d:IsA("BasePart") and d.Material ~= Enum.Material.Plastic then
pcall(function()
d.Material = Enum.Material.Plastic
end)
elseif d:IsA("MeshPart") then
pcall(function()
d.TextureID = ""
end)
elseif d:IsA("Decal") or d:IsA("Texture") then
pcall(function()
d.Texture = ""
d.Transparency = 1
end)
end
end
end)
pcall(function()
Lighting.Technology = Enum.Technology.Compatibility
end)
journal("ТЕКСТУРЫ ВЫКЛ (FPS режим)")
else
if TextureBackup then
pcall(function()
if TextureBackup.MaterialService2022 ~= nil then
local ms = game:GetService("MaterialService")
ms.Use2022Materials = TextureBackup.MaterialService2022
end
end)
pcall(function()
Lighting.Technology = TextureBackup.LightingTech
end)
TextureBackup = nil
end
journal("ТЕКСТУРЫ ВКЛ (восстановлено)")
end
end)
end
