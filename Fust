end)
end

local function klRead()
if type(isfile) ~= "function" or not isfile(KICKLOG_FILE) then return "" end
local ok, c = pcall(readfile, KICKLOG_FILE)
return ok and c or ""
end

local function klRotateIfNeeded()
pcall(function()
