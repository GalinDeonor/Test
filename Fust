makeKeybind = function(sec, data)
data = data or {}
local userCb = data.Callback
local onKey = data.OnKeyChanged
local w
local obj = sec:AddKeybind({
Title = data.Name or data.Title or "Keybind",
Default = data.Default,
Mode = data.Mode or "Toggle",
Callback = function(state)
if userCb then userCb(state) end
end,
ChangedCallback = function(key)
key = normKey(key)
if w then
w.Key = key
pushFlag(w, data.Flag, { Key = tostring(key), Mode = data.Mode or "Toggle" })
end
if onKey then onKey(key) end
end,
})
w = wrapElement(obj, sec, "keybind", data)
w.Key = normKey(data.Default)
pushFlag(w, data.Flag, { Key = tostring(w.Key), Mode = data.Mode or "Toggle" })
return w
end

