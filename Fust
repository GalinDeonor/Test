HudSection = EspPage:Section({ Name = "HUD на экране", Tab = "ESP", Side = 2 })
hudGui = nil 
hudFrame = nil 
hudStroke = nil
hudLineFPS, hudLinePing, hudLineTPS, hudLinePlayers, hudLineAdmin = nil, nil, nil, nil, nil
hudConns = {} 
hudDragging = false
hudDragStart, hudFrameStart = nil, nil
HUD_MARGIN = 12
function hudSnap(corner)
if not hudFrame then
return
end
local ax = (corner and string.find(corner, "Право", 1, true)) and 1 or 0
local ay = (corner and string.find(corner, "верх", 1, true)) and 0 or 1
local ox = (ax == 1) and -HUD_MARGIN or HUD_MARGIN
local oy = (ay == 1) and -HUD_MARGIN or HUD_MARGIN
hudFrame.AnchorPoint = Vector2.new(ax, ay)
hudFrame.Position = UDim2.new(ax, ox, ay, oy)
end
function hudApplyStyle()
if not hudFrame then
return
end
local size = math.clamp(math.floor((S.HUD.Size or 11) + 0.5), 8, 16)
local textT = math.clamp(S.HUD.TextTransparency or 0, 0, 0.9)
local colText = S.HUD.ColorText or Color3.fromRGB(235, 235, 240)
local colBg = S.HUD.ColorBg or Color3.fromRGB(12, 12, 16)
local colStroke = S.HUD.ColorStroke or Color3.fromRGB(255, 170, 40)
for _, line in ipairs({ hudLineFPS, hudLinePing, hudLineTPS, hudLinePlayers, hudLineAdmin }) do
if line then
line.TextSize = size
line.TextTransparency = textT
line.TextColor3 = (line == hudLineAdmin) and Color3.fromRGB(255, 80, 80) or colText
end
end
local bg = math.clamp(S.HUD.BgTransparency or 0.35, 0, 0.95)
if S.HUD.ShowBg then
hudFrame.BackgroundTransparency = bg
hudFrame.BackgroundColor3 = colBg
if hudStroke then
hudStroke.Transparency = math.clamp(bg + 0.25, 0, 1)
hudStroke.Color = colStroke
end
else
hudFrame.BackgroundTransparency = 1
if hudStroke then
hudStroke.Transparency = 1
end
end
if hudLineTPS then
hudLineTPS.Visible = S.HUD.ShowTPS and true or false
end
if hudLineAdmin then
hudLineAdmin.Visible = S.HUD.ShowAdmin and true or false
end
end
function hudDestroy()
for _, c in ipairs(hudConns) do
pcall(function()
c:Disconnect()
end)
end
hudConns = {}
if hudGui then
pcall(function()
hudGui:Destroy()
end)
end
hudGui = nil
hudFrame = nil
hudStroke = nil
hudLineFPS, hudLinePing, hudLineTPS, hudLinePlayers, hudLineAdmin = nil, nil, nil, nil, nil
hudDragging = false
end
function hudEnsure()
if hudFrame then
return
end
local okGui = pcall(function()
local parentGui = (type(gethui) == "function") and gethui() or game:GetService("CoreGui")
hudGui = Instance.new("ScreenGui")
hudGui.Name = "PetuhHUD"
hudGui.ResetOnSpawn = false
hudGui.IgnoreGuiInset = true
hudGui.DisplayOrder = 9999
hudGui.Parent = parentGui
hudFrame = Instance.new("Frame")
hudFrame.Name = "Panel"
hudFrame.Active = true
hudFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
hudFrame.BorderSizePixel = 0
hudFrame.AutomaticSize = Enum.AutomaticSize.XY
hudFrame.Size = UDim2.new(0, 0, 0, 0)
hudFrame.Parent = hudGui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = hudFrame
hudStroke = Instance.new("UIStroke")
hudStroke.Color = Color3.fromRGB(255, 170, 40)
hudStroke.Transparency = 0.6
hudStroke.Parent = hudFrame
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Vertical
layout.Padding = UDim.new(0, 2)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = hudFrame
local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 6)
pad.PaddingBottom = UDim.new(0, 6)
pad.PaddingLeft = UDim.new(0, 9)
pad.PaddingRight = UDim.new(0, 9)
pad.Parent = hudFrame
local order = 0
local function makeLine(text)
order = order + 1
local label = Instance.new("TextLabel")
label.Name = "L" .. order
label.BackgroundTransparency = 1
label.Font = Enum.Font.Code
label.Text = text
label.TextColor3 = Color3.fromRGB(235, 235, 240)
label.TextXAlignment = Enum.TextXAlignment.Left
label.AutomaticSize = Enum.AutomaticSize.XY
label.Size = UDim2.new(0, 0, 0, 0)
label.LayoutOrder = order
label.Parent = hudFrame
return label
end
hudLineFPS = makeLine("FPS —")
hudLinePing = makeLine("Пинг —")
hudLineTPS = makeLine("ТПС —")
hudLinePlayers = makeLine("Игроки —")
hudLineAdmin = makeLine("АДМИН —")
end)
if not okGui or not hudFrame then
warn("[FUST] HUD не создался в этом экзекуторе")
hudDestroy()
return
end
-- 0.39: восстановление сохранённой позиции drag, иначе угол
pcall(function()
if S.HUD.Position and type(S.HUD.Position) == "table" then
hudFrame.AnchorPoint = Vector2.new(0, 0)
hudFrame.Position = UDim2.new(S.HUD.Position.X, 0, S.HUD.Position.Y, 0)
else
hudSnap(S.HUD.Corner)
end
end)
hudApplyStyle()
hudFrame.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
hudDragging = true
hudDragStart = input.Position
local topLeft = hudFrame.AbsolutePosition
hudFrame.AnchorPoint = Vector2.new(0, 0)
hudFrameStart = Vector2.new(topLeft.X, topLeft.Y)
hudFrame.Position = UDim2.fromOffset(topLeft.X, topLeft.Y)
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End
or input.UserInputState == Enum.UserInputState.Cancel then
hudDragging = false
end
end)
end
end)
hudFrame.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
hudDragging = false
end
end)
table.insert(hudConns, UserInputService.InputChanged:Connect(function(input)
if not hudDragging then
return
end
if input.UserInputType == Enum.UserInputType.MouseMovement
or input.UserInputType == Enum.UserInputType.Touch then
if hudDragStart and hudFrameStart and hudFrame then
local cam = Workspace.CurrentCamera
local view = cam and cam.ViewportSize or Vector2.new(1280, 720)
local w = hudFrame.AbsoluteSize.X
local h = hudFrame.AbsoluteSize.Y
local nx = math.clamp(hudFrameStart.X + (input.Position.X - hudDragStart.X), 0, math.max(view.X - w, 0))
local ny = math.clamp(hudFrameStart.Y + (input.Position.Y - hudDragStart.Y), 0, math.max(view.Y - h, 0))
hudFrame.Position = UDim2.fromOffset(nx, ny)
-- 0.39: сохраняем относительную позицию для восстановления после рестарта
if view.X > 0 and view.Y > 0 then
S.HUD.Position = { X = nx / view.X, Y = ny / view.Y }
end
end
end
end))
local frames = 0
local fpsAccum = 0
local fpsValue = 0
local lastServerT = nil
local lastRealT = nil
local tpsEMA = nil
local uiAccum = 0
table.insert(hudConns, RunService.RenderStepped:Connect(function(dt)
frames = frames + 1
fpsAccum = fpsAccum + dt
if fpsAccum >= 1 then
fpsValue = math.floor(frames / fpsAccum + 0.5)
frames = 0
fpsAccum = 0
end
local okT, serverT = pcall(function()
return Workspace:GetServerTimeNow()
end)
if okT and type(serverT) == "number" then
if lastServerT and lastRealT then
local dReal = os.clock() - lastRealT
if dReal >= 1 then
local dServer = serverT - lastServerT
local tps = dServer / dReal
if tps >= 0 and tps <= 61 then
tpsEMA = tpsEMA and (tpsEMA * 0.6 + tps * 0.4) or tps
end
lastServerT = serverT
lastRealT = os.clock()
end
else
lastServerT = serverT
lastRealT = os.clock()
end
end
uiAccum = uiAccum + dt
if uiAccum >= 0.35 then
uiAccum = 0
if hudLineFPS then
hudLineFPS.Text = "FPS " .. tostring(fpsValue)
end
if hudLinePing then
local okP, ping = pcall(function()
return LocalPlayer:GetNetworkPing()
end)
if okP and type(ping) == "number" then
hudLinePing.Text = "Пинг " .. tostring(math.floor(ping * 1000 + 0.5)) .. "мс"
else
hudLinePing.Text = "Пинг —"
end
end
if hudLineTPS then
hudLineTPS.Text = tpsEMA and ("ТПС " .. string.format("%.1f", tpsEMA)) or "ТПС —"
end
if hudLinePlayers then
local n = #Players:GetPlayers()
local maxP = 0
pcall(function()
maxP = Players.MaxPlayers or 0
end)
if maxP and maxP > 0 then
hudLinePlayers.Text = "Игроки " .. tostring(n) .. "/" .. tostring(maxP)
else
hudLinePlayers.Text = "Игроки " .. tostring(n)
end
end
-- 0.39: админ/VIP чек — обновление строки
if hudLineAdmin and S.HUD.ShowAdmin then
local adminCount = AdminScan_Count or 0
local adminNames = AdminScan_Names
if adminCount > 0 then
hudLineAdmin.Text = "АДМИН: " .. tostring(adminCount) .. " — " .. (adminNames or "?")
hudLineAdmin.TextColor3 = Color3.fromRGB(255, 80, 80)
else
hudLineAdmin.Text = "АДМИН: нет"
hudLineAdmin.TextColor3 = Color3.fromRGB(120, 200, 120)
end
end
end
end))
end
