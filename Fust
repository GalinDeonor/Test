function AR_DriftPass()
if not (AntiRecoil.Enabled and AntiRecoil.Drift) then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
if os.clock() < AR_AimBusyUntil then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
if os.clock() >= FUST_FireUntil then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
local camera = Workspace.CurrentCamera
local myChar = LocalPlayer.Character
local myTool = myChar and myChar:FindFirstChildOfClass("Tool")
if not (camera and myTool) then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
pcall(function()
local pitch = camera.CFrame.LookVector.Y
local now = os.clock()
if AR_LastPitch then
local d = pitch - AR_LastPitch
if d < -0.00005 or d > math.rad(2.5) then
AR_DriftFrames = 0
AR_Anchor = nil
elseif d > 0.0001 then
AR_LastDriftAt = now
AR_DriftFrames = AR_DriftFrames + 1
if not AR_Anchor then
AR_Anchor = pitch - d
end
if AR_DriftFrames >= 2 then
FUST_FireUntil = math.max(FUST_FireUntil, now + 0.35)
end
else
if now - AR_LastDriftAt > 0.25 then
AR_DriftFrames = 0
AR_Anchor = nil
end
end
end
AR_LastPitch = pitch
if AR_Anchor then
local err = pitch - AR_Anchor
if err > 0.0006 then
local rate = 0.2 + 0.4 * math.clamp(AntiRecoil.DriftStrength, 0, 1)
local theta = math.asin(math.clamp(err * rate, -1, 1))
camera.CFrame = camera.CFrame * CFrame.Angles(-theta, 0, 0)
AR_LastPitch = camera.CFrame.LookVector.Y
end
end
end)
end
