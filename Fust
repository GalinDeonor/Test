-- Поиск кик-баннера в CoreGui: Roblox при Player:Kick(reason) показывает
-- TextLabel с причиной в CoreGui.RobloxPromptDialog или подобных. Сканируем
-- первые N TextLabel-ов с непустым текстом.
local function klScanKickBanner()
local found = nil
pcall(function()
-- 0.39v3: ищем по всем ScreenGui в CoreGui, не только RobloxPromptDialog
local coreGui = game:GetService("CoreGui")
local scannedTotal = 0
for _, gui in ipairs(coreGui:GetChildren()) do
if gui:IsA("ScreenGui") and gui.Name ~= "PetuhMenuToggle" and gui.Name ~= "PetuhHUD" and gui.Name ~= "PetuhLoadScreen" then
-- проверяем имя gui тоже
local guiName = string.lower(tostring(gui.Name))
if guiName:find("prompt") or guiName:find("dialog") or guiName:find("message") or guiName:find("error") then
for _, desc in ipairs(gui:GetDescendants()) do
scannedTotal = scannedTotal + 1
if scannedTotal > 120 then break end
if desc:IsA("TextLabel") and desc.Text and #desc.Text > 3 then
local t = desc.Text
local tl = string.lower(t)
if tl:find("kick") or tl:find("ban")
or tl:find("вы ") or tl:find("ты ")
or tl:find("обнаружен") or tl:find("detect")
or tl:find("cheat") or tl:find("чит")
or tl:find("exploit") or tl:find("hack")
or tl:find("разблокирован") or tl:find("нарушен")
or tl:find("disconnect") or tl:find("timed out")
or tl:find("соединение") or tl:find("потеряно")
or tl:find("вышли") or tl:find("покинул") then
found = t
break
end
end
end
end
if found then break end
end
end
-- 0.39v3: если не нашли в CoreGui, проверим PlayerGui
if not found then
local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
if pg then
for _, gui in ipairs(pg:GetChildren()) do
if gui:IsA("ScreenGui") then
for _, desc in ipairs(gui:GetDescendants()) do
scannedTotal = scannedTotal + 1
if scannedTotal > 200 then break end
if desc:IsA("TextLabel") and desc.Text and #desc.Text > 3 then
local t = desc.Text
local tl = string.lower(t)
if tl:find("kick") or tl:find("ban") or tl:find("чит") or tl:find("cheat")
or tl:find("detect") or tl:find("обнаружен") then
found = t
break
end
end
end
if found then break end
end
end
end
end
end)
return found
end

-- Главная функция: записать вылет
local function klLogExit(reason, extraText)
pcall(function()
klRotateIfNeeded()
local ts = klTimestamp()
local placeId, placeName, jobId = klPlaceInfo()
local exec = tostring(EXECUTOR_NAME or "неизвестен")
local snap = klSnapshotFeatures()
local banner = extraText or klScanKickBanner()
local entry = {}
table.insert(entry, "==========================================================")
table.insert(entry, "[" .. ts .. "] " .. reason)
table.insert(entry, "  Place:    " .. placeId .. " (" .. placeName .. ")")
table.insert(entry, "  JobId:    " .. jobId)
table.insert(entry, "  Executor: " .. exec)
if banner then
table.insert(entry, "  KickMsg:  " .. banner)
end
table.insert(entry, "  --- Active features at exit ---")
table.insert(entry, snap)
table.insert(entry, "==========================================================")
local msg = table.concat(entry, "\n")
klAppend(msg)
print("[FUST-KL] " .. msg)
warn("[FUST-KL] ВЫЛЕТ ЗАЛОГИРОВАН: " .. KICKLOG_FILE .. " — скинь скрин консоли.")
end)
end

-- Стартовая проверка: прошлый запуск abruptly завершился?
local function klCheckPreviousRun()
pcall(function()
local log = klRead()
if #log == 0 then return end
-- Ищем последнюю запись "ЗАПУСК" / START и DEACTIVATED.
-- Luau не любит \[ в обычных строках — используем long-string + % escape.
local lastStart = log:match([[.-%[(.-)%] === ЗАПУСК 0%.39]])
or log:match([[.-%[(.-)%] FUST_KL_Active_START]])
local lastDeactivate = log:match([[.-%[(.-)%] FUST_KL_DEACTIVATED]])
if lastStart and not lastDeactivate then
-- Прошлый запуск не завершился нормально → abrupt exit
local ts = klTimestamp()
local placeId, placeName, jobId = klPlaceInfo()
local exec = tostring(EXECUTOR_NAME or "неизвестен")
local msg = "==========================================================\n"
.. "[" .. ts .. "] PREVIOUS RUN: ABRUPT EXIT\n"
.. "  Предыдущий запуск (начат " .. (lastStart or "?") .. ") НЕ завершился\n"
.. "  нормальной деактивацией — возможный КИК/БАН во время игры.\n"
.. "  Place:    " .. placeId .. " (" .. placeName .. ")\n"
.. "  JobId:    " .. jobId .. "\n"
.. "  Executor: " .. exec .. "\n"
.. "  Смотри последнюю запись 'ВЫЛЕТ' выше для деталей.\n"
.. "=========================================================="
klAppend(msg)
print("[FUST-KL] PREVIOUS RUN: ABRUPT EXIT — смотри " .. KICKLOG_FILE)
end
end)
end

-- Хук на FUST_Deactivate: пишем маркер нормального выхода
