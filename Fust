return model:FindFirstChildOfClass("Tool")
end)
if okT and tool then
local okN, tname = pcall(function()
return string.lower(tostring(tool.Name))
end)
if okN and tname then
for _, pat in ipairs(WEAPON_PATTERNS) do
if string.find(tname, pat, 1, true) then
return true
end
end
end
end
return false
end
function npcSleeperMarked(model, hum, root)
