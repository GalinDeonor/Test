-- 0.39v2: УЛУЧШЕННАЯ ПРЕДИКЦИЯ
-- Старая: фиксированный lead = dist/900. Проблема: при быстрой цели наводились
-- слишком вперёд, не успевали скорректировать. Новая: адаптивная — учитываем
-- скорость цели относительно камеры + clamp по дальности + множитель.
-- Если цель БЫСТРО движется перпендикулярно — упреждение больше.
-- Если цель идёт НА нас или ОТ нас — упреждение меньше (не нужно).
function autoLead(dist, targetVel, camLook)
local base = math.clamp(dist / 900, 0.05, 1.2) * math.clamp(Aim.AutoPredictK or 1, 0.1, 5)
-- если передана скорость цели и направление камеры — корректируем
if targetVel and camLook then
local vMag = targetVel.Magnitude
if vMag > 0.1 then
-- перпендикулярная составляющая скорости к camLook — её и нужно упреждать
local perp = targetVel - camLook * targetVel:Dot(camLook)
local perpMag = perp.Magnitude
-- если цель идёт почти на нас — упреждение минимально
if perpMag < 2 then
base = base * 0.3
elseif perpMag > 30 then
-- быстрая перпендикулярная цель — упреждение больше
base = base * 1.4
end
end
end
return base
end
