function heliFindAimPart(heli)
-- ищем BodyPart / Seat / Main rotor для прицеливания
local bestPart = nil
local bestScore = -math.huge
pcall(function()
-- приоритет: PilotSeat, DriverSeat, Main, Body, HeliBody
local priority = { "PilotSeat", "DriverSeat", "Main", "Body", "HeliBody", "Cabin", "Tail", "Rotor", "MainRotor" }
for _, p in ipairs(heli:GetDescendants()) do
if p:IsA("BasePart") then
local name = string.lower(tostring(p.Name))
local score = 0
for i, pn in ipairs(priority) do
if string.find(name, string.lower(pn), 1, true) then
score = 100 - i
break
end
end
if score == 0 then score = 10 end -- любой BasePart подходит
if score > bestScore then
bestScore = score
bestPart = p
end
end
end
end)
return bestPart
end
