o.From = Vector2.new(base.From.X + off[1] * ot, base.From.Y + off[2] * ot)
o.To = Vector2.new(base.To.X + off[1] * ot, base.To.Y + off[2] * ot)
o.Thickness = th + ot * 2
o.Color = Color3.fromRGB(0, 0, 0)
o.Transparency = 1 - alpha
o.Visible = true
end
oi = oi + 1
end
end
end
for i = oi, 8 do
