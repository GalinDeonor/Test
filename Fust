trackedHelis = {} -- кэш найденных вертолётов
heliScanAt = 0
function heliScanWorkspace()
local now = os.clock()
if now - heliScanAt < 2.0 then return end -- раз в 2с
heliScanAt = now
local found = {}
pcall(function()
-- 1. По тегам CollectionService
for _, tag in ipairs(HELI_TAGS) do
local ok, items = pcall(CollectionService.GetTagged, CollectionService, tag)
if ok and items then
for _, inst in ipairs(items) do
if inst:IsA("Model") and inst.Parent then
table.insert(found, inst)
end
end
end
end
-- 2. Поиск по папкам
for _, folder in ipairs(HELI_FOLDER_NAMES) do
local okF, f = pcall(function()
return Workspace:FindFirstChild(folder, true)
end)
if okF and f then
for _, d in ipairs(f:GetDescendants()) do
if d:IsA("Model") then
table.insert(found, d)
end
end
end
end
-- 3. Поиск по имени в верхнем уровне Workspace
for _, d in ipairs(Workspace:GetChildren()) do
if d:IsA("Model") then
local okN, name = pcall(function() return string.lower(tostring(d.Name)) end)
if okN then
for _, pat in ipairs(HELI_PATTERNS) do
if string.find(name, pat, 1, true) then
table.insert(found, d)
break
end
end
end
end
end
end)
-- дедуп
local seen = {}
local unique = {}
for _, h in ipairs(found) do
if not seen[h] then
seen[h] = true
table.insert(unique, h)
end
end
trackedHelis = unique
end
function heliFindAimPart(heli)
-- ищем BodyPart / Seat / Main rotor для прицеливания
local bestPart = nil
local bestScore = -math.huge
pcall(function()
-- приоритет: PilotSeat, DriverSeat, Main, Body, HeliBody
local priority = { "PilotSeat", "DriverSeat", "Main", "Body", "HeliBody", "Cabin", "Tail", "Rotor", "MainRotor" }
for _, p in ipairs(heli:GetDescendants()) do
if p:IsA("BasePart") then
local name = string.lower(tostring(p.Name))
local score = 0
for i, pn in ipairs(priority) do
if string.find(name, string.lower(pn), 1, true) then
score = 100 - i
break
end
end
if score == 0 then score = 10 end -- любой BasePart подходит
if score > bestScore then
bestScore = score
bestPart = p
end
end
end
end)
return bestPart
end
