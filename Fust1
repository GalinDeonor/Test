local SectionWrapper = {}
SectionWrapper.__index = SectionWrapper

local function newSection(nlSec)
        local self = setmetatable({}, SectionWrapper)
        self.NLSection = nlSec
        -- 0.48 UPGRADE: раньше (LiquidGlass) Items["Content"].Instance был заглушкой и
        -- вайтлист-панель с cfgStatus были НЕВИДИМЫ. Теперь отдаём реальный фрейм секции
        -- Neverlose — кастомный UI (wlPanel, cfgStatus) реально отображается в секции.
        self.Items = setmetatable({}, {
                __index = function(_, k)
                        if k == "Content" then
                                local frame = nil
                                pcall(function()
                                        if nlSec and nlSec.Frame then frame = nlSec.Frame end
                                end)
                                return { Instance = frame }
                        end
                        return nil
                end,
        })
        return self
end

