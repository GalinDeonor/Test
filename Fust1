local function newWindow(nlWin)
        local self = {}
        self.LGWindow = nlWin
        self.IsOpen = true
        self.Pages = {}
        self.Items = {}
        self.TabSections = {} -- [PageName] = tabsection Neverlose

        function self:Group()
                -- группы навигации старой библиотеки — не поддерживаются, no-op
        end

        function self:IsOpenLive()
                local ok, v = pcall(function() return nlWin.SG.Enabled end)
                if ok and type(v) == "boolean" then return v end
                return self.IsOpen
        end

        function self:SetOpen(b)
                if b == nil then b = not self:IsOpenLive() end
                pcall(function() nlWin.SG.Enabled = b and true or false end)
                self.IsOpen = b and true or false
        end

        function self:Page(Data)
                Data = Data or {}
                local Page = { Name = Data.Name or "Page", Icon = Data.Icon, Tabs = {}, Win = self }

                function Page:Section(SecData)
                        SecData = SecData or {}
                        local tabName = SecData.Tab or self.Name
                        -- TabSection Neverlose — один на Page (создаётся лениво)
                        local ts = self.Win.TabSections[self.Name]
                        if not ts then
                                pcall(function()
                                        ts = nlWin:TabSection({ text = "" })
                                        self.Win.TabSections[self.Name] = ts
                                end)
                        end
                        -- вкладка Neverlose создаётся лениво: одна на уникальный Tab внутри Page
                        local entry = self.Tabs[tabName]
                        if not entry and ts then
                                local okT, nlTab = pcall(function()
                                        return ts:Tab({ text = tostring(tabName), icon = self.Icon })
                                end)
                                if okT and nlTab then
                                        entry = nlTab
                                        self.Tabs[tabName] = nlTab
                                end
                        end
                        local nlSec = nil
                        pcall(function()
                                nlSec = entry:Section({ text = SecData.Name or "" })
                        end)
                        if not nlSec then
                                -- фолбэк: невидимая секция-заглушка, чтобы UI не падал
                                nlSec = { Frame = Instance.new("Frame") }
                        end
                        return newSection(nlSec)
                end

                table.insert(self.Pages, Page)
                return Page
        end

        return self
end

function Library:Window(Data)
        Data = Data or {}
        local nlWin = LG:Window({ text = Data.Name or "ПЬЯНЫЙ ПЕТУХ" })
        Library.NLWindow = nlWin
        local win = newWindow(nlWin)

        -- хоткей меню (RightControl по умолчанию; PETUH_MENU_KEY обновляется
        -- через OnKeyChanged в настройках)
        pcall(function()
                local UIS = game:GetService("UserInputService")
                Library:Connect(UIS.InputBegan, function(input, gp)
                        if gp then return end
                        local key = getgenv().PETUH_MENU_KEY or Enum.KeyCode.RightControl
                        if input.KeyCode == key then
                                win:SetOpen(not win:IsOpenLive())
                        end
                end)
        end)

        -- мобильная кнопка меню (иконка петуха, тап = открыть/закрыть)
        pcall(function()
                local UIS = game:GetService("UserInputService")
                if UIS.TouchEnabled == true then
                        local icon = PETUH_ICON_ASSET or "rbxassetid://134242818164054"
                        local mbtn = Instance.new("ImageButton")
                        mbtn.Name = "FUST_MobileMenu"
                        mbtn.Image = icon
                        mbtn.ScaleType = Enum.ScaleType.Fit
                        mbtn.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
                        mbtn.BackgroundTransparency = 0.25
                        mbtn.BorderSizePixel = 0
                        mbtn.Size = UDim2.fromOffset(44, 44)
                        mbtn.Position = UDim2.new(0, 10, 0.5, -22)
                        mbtn.Active = true
                        mbtn.AutoButtonColor = false
                        mbtn.Parent = Library.Holder.Instance
                        local mc = Instance.new("UICorner")
                        mc.CornerRadius = UDim.new(0, 8)
                        mc.Parent = mbtn
                        local ms = Instance.new("UIStroke")
                        ms.Color = ACCENT_RED
                        ms.Thickness = 1.5
                        ms.Transparency = 0.3
                        ms.Parent = mbtn
                        -- drag пальцем + тап
                        local mdrag, mstart, mpos, mmoved
                        mbtn.InputBegan:Connect(function(input)
                                if input.UserInputType == Enum.UserInputType.MouseButton1
                                or input.UserInputType == Enum.UserInputType.Touch then
                                        mdrag = true
                                        mmoved = false
                                        mstart = input.Position
                                        mpos = mbtn.Position
                                        input.Changed:Connect(function()
                                                if input.UserInputState == Enum.UserInputState.End then mdrag = false end
                                        end)
                                end
                        end)
                        mbtn.InputChanged:Connect(function(input)
                                if input.UserInputType == Enum.UserInputType.Touch
                                or input.UserInputType == Enum.UserInputType.MouseMovement then
                                        if mdrag then
                                                local d = input.Position - mstart
                                                if d.Magnitude > 8 then mmoved = true end
                                                mbtn.Position = UDim2.new(mpos.X.Scale, mpos.X.Offset + d.X, mpos.Y.Scale, mpos.Y.Offset + d.Y)
                                        end
                                end
                        end)
                        mbtn.MouseButton1Click:Connect(function()
                                if not mmoved then
                                        win:SetOpen(not win:IsOpenLive())
                                end
                        end)
                        -- отдаём в формате, который ждёт основной код:
                        -- Window.LGWindow.MobileButton.Root
                        nlWin.MobileButton = { Root = mbtn }
                end
        end)

        return win
end

