	if not preset then
		warn(("[LiquidGlass] unknown density %q (Compact, Regular, Large)"):format(tostring(name)))
		return
	end
	for k, v in pairs(BASE_METRICS) do
		S[k] = v
	end
	Library.Settings.Density = type(name) == "string" and name or "Custom"
	Library:SetMetrics(preset)
end

