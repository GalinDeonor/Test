sh()
	return el
end

function Section:AddSpacer(h)
	local el = self:_element({ Title = "" }, "Spacer", { MinHeight = h or 12, PadY = 0, Title = "" })
	el.Row.Body.Visible = false
	el.NoSeparator = true
	self:_refresh()
	return el
end

-- anything else: Build(container, element) receives a frame inside the card
function Section:AddCustom(a, b)
	local o = type(a) == "function" and { Build = a } or (a or {})
	local build = b or opt(o, nil, "Build", "Callback", "Create")
	o.Callback = nil
	local el = self:_element(o, "Custom", { PadY = opt(o, S.RowPadY + 2, "Padding"), MinHeight = opt(o, 0, "MinHeight") })
	el.Row.TopIcon()
	local container = new("Frame", { Name = "Custom", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opt(o, 0, "Height")), AutomaticSize = opt(o, nil, "Height") and Enum.AutomaticSize.None or Enum.AutomaticSize.Y, LayoutOrder = 3, ZIndex = 7, Parent = el.Row.Body })
	if el.TitleText == "" then
		el.Row.Title.Visible = false
	end
	el.Container = container
	if build then
		local ok, err = pcall(build, container, el, Library)
		if not ok then
			warn("[LiquidGlass] custom element: " .. tostring(err))
		end
	end
	return el
end

---------------------------------------------------------------------------
-- Tabs forward every element constructor to their current section
---------------------------------------------------------------------------
local ALIASES = {
	CreateButton = "AddButton", CreateToggle = "AddToggle", CreateSlider = "AddSlider",
	CreateDropdown = "AddDropdown", CreateInput = "AddInput", CreateKeybind = "AddKeybind",
	CreateColorPicker = "AddColorPicker", CreateLabel = "AddLabel", CreateParagraph = "AddParagraph",
	CreateDivider = "AddDivider", CreateImage = "AddImage", AddCheckbox = "AddToggle", AddSwitch = "AddToggle",
	AddList = "AddDropdown", AddSelect = "AddDropdown", AddTextLabel = "AddLabel", AddText = "AddLabel",
	AddSeparator = "AddDivider", AddPicture = "AddImage", AddProgressbar = "AddProgress",
}
for alias, target in pairs(ALIASES) do
	Section[alias] = Section[target]
end
for name, fn in pairs(Section) do
	if type(fn) == "function" and (name:sub(1, 3) == "Add" or name:sub(1, 6) == "Create") and not Tab[name] and name ~= "AddSection" then
		Tab[name] = function(self, ...)
			local s = self:_section()
			return fn(s, ...)
		end
	end
end

---------------------------------------------------------------------------
-- Popovers: one at a time, anchored to a GuiObject, closed by an outside click,
-- Escape, or the anchor moving away. They grow out of their anchor corner.
---------------------------------------------------------------------------
local function anchorRect(anchor)
	local s = Library.ScaleObject.Scale
	return screenPos(anchor) / s, anchor.AbsoluteSize / s
end

function Overlay.popover(o)
	if Overlay.active then
		Overlay.active.Close()
	end
	local s = Library.ScaleObject.Scale
	local vs = camera.ViewportSize / s
	local width, height = o.Width or 240, o.Height or 200
	local aPos, aSize = anchorRect(o.Anchor)
	local below = aPos.Y + aSize.Y + 6 + height < vs.Y - 10
	local x = o.Align == "Left" and aPos.X + 8 or (o.Align == "Center" and aPos.X + aSize.X / 2 or aPos.X + aSize.X - 8)
	local ax = o.Align == "Left" and 0 or (o.Align == "Center" and 0.5 or 1)
	local y = below and (aPos.Y + aSize.Y + 4) or (aPos.Y - 4)
	x = math.clamp(x, width * ax + 8, vs.X - width * (1 - ax) - 8)

	local catcher = new("TextButton", { Name = "PopoverCatcher", BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), ZIndex = nextZ(), Parent = Library.Gui })
	local g = Glass.new({
		Kind = "Surface",
		Dense = true,
		Name = o.Name or "Popover",
		Parent = Library.Gui,
		Radius = o.Radius or S.PopoverRadius,
		AnchorPoint = Vector2.new(ax, below and 0 or 1),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		ZIndex = nextZ(5),
		BlurStart = 0,
	})
	g.Root.Active = true
	local pop = { Glass = g, Root = g.Root, Content = g.Content, Closed = false }
	g.Scale.Scale = 0.82
	Glass.surfaceFade(g, false, 0)
	Glass.surfaceFade(g, true, 0.2)
	tween(g.Scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	g.BlurRegion:SetTarget(1, 16)
	local startPos = screenPos(o.Anchor)
	local follow
	function pop.Close()
		if pop.Closed then
			return
		end
		pop.Closed = true
		if Overlay.active == pop then
			Overlay.active = nil
		end
		catcher:Destroy()
		if follow then
			follow:Disconnect()
		end
		tween(g.Scale, 0.2, { Scale = 0.9 }, Enum.EasingStyle.Quad)
		Glass.surfaceFade(g, false, 0.18)
		g.BlurRegion:SetTarget(0, 18)
		Motion.groupFade(g.Content.Parent and g.Content or g.Root, 0, 1, 0.18)
		task.delay(0.25, function()
			g.Root:Destroy()
		end)
		Util.fire(o.OnClose)
	end
	catcher.Activated:Connect(pop.Close)
	catcher.MouseButton2Click:Connect(pop.Close)
	follow = RunService.RenderStepped:Connect(function()
		if not o.Anchor.Parent or (screenPos(o.Anchor) - startPos).Magnitude > 3 then
			pop.Close()
		end
	end)
	Overlay.active = pop
	return pop
end

-- Escape always reaches Roblox's own menu too (core bindings can't be sunk),
-- so overlays close on Escape and whenever that menu opens.
local function dismissOverlays()
	if Overlay.active then
		Overlay.active.Close()
	elseif Overlay.dialog then
		Overlay.dialog.Cancel()
	end
end
Util.track(UserInputService.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Escape then
		dismissOverlays()
	end
end))
Util.track(GuiService.MenuOpened:Connect(function()
	if Overlay.active then
		Overlay.active.Close()
	end
end))

