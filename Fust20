-- OnKeyChanged обновляет FreeCamKeys (для совместимости со старым кодом).
UIRegistry.FreeCamKeyToggle = FreeCamSection:Label("Клавиша: вкл/выкл фрикам"):Keybind({
Name = "Клавиша: вкл/выкл фрикам",
Flag = "FreeCamKeyToggle",
Default = Enum.KeyCode.K,
Mode = "Toggle",
Callback = function(state)
-- 0.42: freecamEnable/Disable определены ниже в файле, но Callback зовётся
-- только при нажатии клавиши (не при создании) — к тому моменту всё готово.
-- pcall защищает от "attempt to call nil" если что-то пошло не так.
pcall(function()
if state then freecamEnable() else freecamDisable() end
end)
end,
OnKeyChanged = function(key)
