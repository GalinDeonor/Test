			local bdT = 1 - ease(now / 0.45) + out
			backdrop.Transparency = math.clamp(bdT, 0, 1)
			local hW = viewHeight(WALL)
			backdrop.Size = Vector3.new(hW * vs.X / vs.Y * 1.3, hW * 1.3, 0.05)
