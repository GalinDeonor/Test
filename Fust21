-- ================= утилиты =================
local function normKey(k)
if typeof(k) == "EnumItem" then return k end
if type(k) == "string" then
local name = string.match(k, "%.([%w]+)$") or k
if Enum.KeyCode[name] then return Enum.KeyCode[name] end
end
return k
end

local function colorFrom(v)
if typeof(v) == "Color3" then return v end
if type(v) == "string" then
local s = (v:sub(1, 1) == "#") and v or ("#" .. v)
local ok, c = pcall(Color3.fromHex, s)
if ok and c then return c end
elseif type(v) == "table" then
if (v[1] or 0) > 1 or (v[2] or 0) > 1 or (v[3] or 0) > 1 then
return Color3.fromRGB(v[1] or 255, v[2] or 255, v[3] or 255)
end
return Color3.new(v[1] or 1, v[2] or 1, v[3] or 1)
end
return Color3.fromRGB(255, 255, 255)
end

local function pushFlag(w, flag, value)
if flag and flag ~= "" then
Library.Flags[flag] = value
Library.SetFlags[flag] = w
end
end

-- конструкторы прикреплённых элементов (объявлены заранее для замыканий)
local makeColorpicker, makeKeybind

-- ================= обёртка элемента =================
local function wrapElement(lgObj, lgSection, kind, data)
data = data or {}
local flag = data.Flag
local w
w = {
Obj = lgObj,
Section = lgSection,
Kind = kind,
Title = data.Name or data.Title or "",
Value = nil,
Key = nil,
Color = nil,
}

function w:Set(v, silent)
pcall(function()
if kind == "keybind" then
v = normKey(v)
if w.Obj and w.Obj.Set then w.Obj:Set(v) end
w.Key = v
pushFlag(w, flag, { Key = tostring(v), Mode = data.Mode or "Toggle" })
elseif kind == "color" then
v = colorFrom(v)
if w.Obj and w.Obj.Set then w.Obj:Set(v) end
w.Color = v
pushFlag(w, flag, { Color = "#" .. v:ToHex() })
elseif kind == "label" then
if w.Obj and w.Obj.SetTitle then w.Obj:SetTitle(tostring(v)) end
w.Value = v
pushFlag(w, flag, v)
elseif kind == "paragraph" then
if type(v) == "table" then
if w.Obj and w.Obj.Set then w.Obj:Set(v) end
else
if w.Obj and w.Obj.Set then w.Obj:Set({ Content = tostring(v) }) end
end
w.Value = v
pushFlag(w, flag, v)
else
if w.Obj and w.Obj.Set then w.Obj:Set(v, silent == true) end
w.Value = v
pushFlag(w, flag, v)
end
end)
end

function w:SetText(t)
pcall(function() if w.Obj and w.Obj.SetTitle then w.Obj:SetTitle(tostring(t)) end end)
w.Title = t
end
w.SetTitle = w.SetText

function w:SetVisible(b)
pcall(function() if w.Obj and w.Obj.SetVisible then w.Obj:SetVisible(b) end end)
end

function w:Destroy()
pcall(function() if w.Obj and w.Obj.Destroy then w.Obj:Destroy() end end)
end

function w:Fire()
pcall(function() if w.Obj and w.Obj.Fire then w.Obj:Fire() end end)
end

-- прикреплённые элементы (как в старой библиотеке: Toggle:Colorpicker() и т.п.)
function w:Colorpicker(d)
d = d or {}
d.Name = d.Name or w.Title
return makeColorpicker(lgSection, d)
end

-- 0.42 FIX: в старой VOMAGLA Label():Keybind() делал прикреплённый кейбинд
-- (внутри Label'а). В LiquidGlass это невозможно — Keybind самостоятельный
-- элемент. Раньше создавалось ДВА элемента (Label + Keybind) = "размножилось".
-- Теперь: если родитель — Label/Paragraph, прячем его (SetVisible(false)),
-- а Title родителя переносим в Keybind.
function w:Keybind(d)
d = d or {}
if (w.Kind == "label" or w.Kind == "paragraph") and w.Title and (not d.Name or d.Name == "") then
d.Name = w.Title
end
local kb = makeKeybind(lgSection, d)
if w.Kind == "label" or w.Kind == "paragraph" then
pcall(function() if w.SetVisible then w:SetVisible(false) end end)
end
return kb
end

return w
end

-- ================= конструкторы элементов =================
local function makeToggle(sec, data)
data = data or {}
local userCb = data.Callback
local w
local obj = sec:AddToggle({
Title = data.Name or data.Title or "Toggle",
Description = data.Description,
Default = data.Default == nil and false or data.Default,
Flag = data.Flag,
Callback = function(v)
if w then
w.Value = v
pushFlag(w, data.Flag, v)
end
if userCb then userCb(v) end
end,
})
w = wrapElement(obj, sec, "toggle", data)
w.Value = data.Default == nil and false or data.Default
pushFlag(w, data.Flag, w.Value)
return w
end

local function makeSlider(sec, data)
data = data or {}
local userCb = data.Callback
local w
local opts = {
Title = data.Name or data.Title or "Slider",
Min = data.Min or 0,
Max = data.Max or 100,
Default = data.Default or data.Min or 0,
Suffix = data.Suffix,
Prefix = data.Prefix,
Callback = function(v)
if w then
w.Value = v
pushFlag(w, data.Flag, v)
end
if userCb then userCb(v) end
end,
}
-- 0.41 FIX: в старой VOMAGLA Decimals = ШАГ слайдера (0.05, 5, 50...),
-- а не кол-во знаков. LiquidGlass Rounding = кол-во знаков, и при дробном
-- шаге (0.05) string.format("%.0.05f") падает с invalid option '%.'.
-- Передаём Decimals как Step — LiquidGlass сам посчитает знаки из шага.
if data.Decimals and data.Decimals > 0 then
opts.Step = data.Decimals
end
local obj = sec:AddSlider(opts)
w = wrapElement(obj, sec, "slider", data)
w.Value = opts.Default
pushFlag(w, data.Flag, opts.Default)
return w
end

local function makeDropdown(sec, data)
data = data or {}
local userCb = data.Callback
local w
local obj = sec:AddDropdown({
Title = data.Name or data.Title or "Dropdown",
Options = data.Items or data.Values or {},
Multi = data.Multi == true,
Default = data.Default,
Placeholder = data.Placeholder,
Callback = function(v)
if w then
w.Value = v
pushFlag(w, data.Flag, v)
end
if userCb then userCb(v) end
end,
})
w = wrapElement(obj, sec, "dropdown", data)
w.Value = data.Default
if data.Default ~= nil then
pushFlag(w, data.Flag, data.Default)
end
return w
end

makeKeybind = function(sec, data)
data = data or {}
local userCb = data.Callback
local onKey = data.OnKeyChanged
local w
local obj = sec:AddKeybind({
Title = data.Name or data.Title or "Keybind",
Default = data.Default,
Mode = data.Mode or "Toggle",
Callback = function(state)
if userCb then userCb(state) end
end,
ChangedCallback = function(key)
key = normKey(key)
if w then
w.Key = key
pushFlag(w, data.Flag, { Key = tostring(key), Mode = data.Mode or "Toggle" })
end
if onKey then onKey(key) end
end,
})
w = wrapElement(obj, sec, "keybind", data)
w.Key = normKey(data.Default)
pushFlag(w, data.Flag, { Key = tostring(w.Key), Mode = data.Mode or "Toggle" })
return w
end

makeColorpicker = function(sec, data)
data = data or {}
local userCb = data.Callback
local w
local obj = sec:AddColorPicker({
Title = data.Name or data.Title or "Цвет",
Default = colorFrom(data.Default),
Callback = function(c)
if w then
w.Color = c
pushFlag(w, data.Flag, { Color = "#" .. c:ToHex() })
end
if userCb then userCb(c) end
end,
})
w = wrapElement(obj, sec, "color", data)
w.Color = colorFrom(data.Default)
pushFlag(w, data.Flag, { Color = "#" .. w.Color:ToHex() })
return w
end

local function makeButton(sec, data)
data = data or {}
local obj = sec:AddButton({
Title = data.Name or data.Title or "Button",
Description = data.Description,
Style = data.Style,
Callback = data.Callback,
})
return wrapElement(obj, sec, "button", data)
end

local function makeLabel(sec, text)
local t = tostring(text or "")
local obj = sec:AddLabel(t)
local w = wrapElement(obj, sec, "label", { Name = t })
w.Value = t
return w
end

local function makeTextbox(sec, data)
data = data or {}
local userCb = data.Callback
local w
local opts = {
Title = data.Name or data.Title or "Input",
Placeholder = data.Placeholder,
Default = data.Default,
Callback = function(text)
if w then
w.Value = text
pushFlag(w, data.Flag, text)
end
if userCb then userCb(text) end
end,
}
if data.MultiLine or data.Multiline then
opts.Multiline = true
opts.Height = data.Height or 140
end
local obj = sec:AddInput(opts)
w = wrapElement(obj, sec, "input", data)
w.Value = data.Default or ""
if data.Default ~= nil then
pushFlag(w, data.Flag, data.Default)
end
return w
end

local function makeParagraph(sec, data)
if type(data) == "string" then data = { Content = data } end
data = data or {}
local obj = sec:AddParagraph({
Title = data.Name or data.Title or "",
Content = data.Content or data.Text or "",
})
return wrapElement(obj, sec, "paragraph", data)
end

