-- ================= конфиги =================
function Library:GetConfig()
local Config = {}
for flag, v in pairs(Library.Flags) do
pcall(function()
if type(v) == "table" and v.Key ~= nil then
Config[flag] = { Key = tostring(v.Key), Mode = tostring(v.Mode or "Toggle") }
elseif type(v) == "table" and v.Color ~= nil then
Config[flag] = { Color = v.Color }
else
Config[flag] = v
end
end)
end
return game:GetService("HttpService"):JSONEncode(Config)
end

function Library:LoadConfig(Raw)
local ok, decoded = pcall(function()
return game:GetService("HttpService"):JSONDecode(Raw)
end)
if not ok or type(decoded) ~= "table" then
warn("[ПП] LoadConfig: конфиг битый")
return false
end
for flag, value in pairs(decoded) do
local w = Library.SetFlags[flag]
if w and w.Set then
pcall(function()
if type(value) == "table" and value.Key ~= nil then
w:Set(value.Key)
elseif type(value) == "table" and value.Color ~= nil then
w:Set(value.Color)
else
w:Set(value)
end
end)
end
end
return true
end

function Library:DeleteConfig(Config)
pcall(function()
if type(isfile) == "function" and isfile(Library.Folders.Configs .. "/" .. Config) then
delfile(Library.Folders.Configs .. "/" .. Config)
end
end)
end

function Library:RefreshConfigsList(Element)
local list = {}
pcall(function()
if type(listfiles) == "function" then
for _, f in ipairs(listfiles(Library.Folders.Configs)) do
local name = string.match(tostring(f), "([^/\\]+)%.json$")
if name then table.insert(list, name) end
end
end
end)
if Element and Element.Obj then
pcall(function()
if Element.Obj.SetOptions then Element.Obj:SetOptions(list, false) end
end)
end
return list
end

