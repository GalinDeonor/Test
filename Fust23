function AR_DriftPass()
if not (AntiRecoil.Enabled and AntiRecoil.Drift) then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
if os.clock() < AR_AimBusyUntil then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
if os.clock() >= FUST_FireUntil then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
local camera = Workspace.CurrentCamera
local myChar = LocalPlayer.Character
local myTool = myChar and myChar:FindFirstChildOfClass("Tool")
if not (camera and myTool) then
AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
return
end
pcall(function()
local pitch = camera.CFrame.LookVector.Y
local now = os.clock()
if AR_LastPitch then
local d = pitch - AR_LastPitch
if d < -0.00005 or d > math.rad(2.5) then
AR_DriftFrames = 0
AR_Anchor = nil
elseif d > 0.0001 then
AR_LastDriftAt = now
AR_DriftFrames = AR_DriftFrames + 1
if not AR_Anchor then
AR_Anchor = pitch - d
end
if AR_DriftFrames >= 2 then
FUST_FireUntil = math.max(FUST_FireUntil, now + 0.35)
end
else
if now - AR_LastDriftAt > 0.25 then
AR_DriftFrames = 0
AR_Anchor = nil
end
end
end
AR_LastPitch = pitch
if AR_Anchor then
local err = pitch - AR_Anchor
if err > 0.0006 then
local rate = 0.2 + 0.4 * math.clamp(AntiRecoil.DriftStrength, 0, 1)
local theta = math.asin(math.clamp(err * rate, -1, 1))
camera.CFrame = camera.CFrame * CFrame.Angles(-theta, 0, 0)
AR_LastPitch = camera.CFrame.LookVector.Y
end
end
end)
end
function FUST_BindFireTool(tool)
if tool == FUST_FireTool then
return
end
if FUST_FireConns then
for _, c in ipairs(FUST_FireConns) do
pcall(function()
c:Disconnect()
end)
end
end
FUST_FireConns = nil
FUST_FireTool = tool
if not tool then
FUST_FireUntil = 0
return
end
local conns = {}
local function markFire()
if getgenv().FUST_SESSION ~= FUST_SESSION then
for _, c in ipairs(conns) do
pcall(function()
c:Disconnect()
end)
end
return
end
FUST_FireUntil = os.clock() + 0.6
end
local function markStop()
if getgenv().FUST_SESSION ~= FUST_SESSION then
return
end
FUST_FireUntil = math.max(FUST_FireUntil, os.clock() + 0.3)
end
table.insert(conns, tool.Activated:Connect(markFire))
table.insert(conns, tool.Deactivated:Connect(markStop))
FUST_FireConns = conns
end
getgenv().FUST_ASCleanup = function()
if FUST_FireConns then
for _, c in ipairs(FUST_FireConns) do
pcall(function()
c:Disconnect()
end)
end
end
FUST_FireConns = nil
FUST_FireTool = nil
FUST_FireUntil = 0
end
function AS_Pass()
local camera = Workspace.CurrentCamera
local myChar = LocalPlayer.Character
local myTool = myChar and myChar:FindFirstChildOfClass("Tool")
if FreeCam.Enabled then
AS_LastRawPitch, AS_LastDp, AS_LastDy = nil, nil, nil
AS_LastLX, AS_LastLZ = nil, nil
AS_AnchorLook, AS_SmoothPos = nil, nil
AS_PitchFlips, AS_YawFlips = 0, 0
return
end
if not (AntiShake.Enabled and camera and myTool) then
AS_LastRawPitch, AS_LastDp, AS_LastDy = nil, nil, nil
AS_LastLX, AS_LastLZ = nil, nil
AS_AnchorLook, AS_SmoothPos = nil, nil
AS_PitchFlips, AS_YawFlips = 0, 0
return
end
local aimBusy = os.clock() < AR_AimBusyUntil
pcall(function()
local cf = camera.CFrame
local look = cf.LookVector
local pos = cf.Position
local now = os.clock()
local firing = now < FUST_FireUntil
if AntiShake.Roll and firing and math.abs(look.Y) < 0.999 then
local roll = math.asin(math.clamp(cf.RightVector.Y, -1, 1))
if math.abs(roll) > math.rad(0.05) then
camera.CFrame = CFrame.lookAt(pos, pos + look)
cf = camera.CFrame
end
end
if AntiShake.Position then
if firing then
if AS_SmoothPos and (pos - AS_SmoothPos).Magnitude < 1.5 then
AS_SmoothPos = AS_SmoothPos:Lerp(pos, 0.35)
camera.CFrame = CFrame.new(AS_SmoothPos) * (cf - cf.Position)
cf = camera.CFrame
else
AS_SmoothPos = pos
end
else
AS_SmoothPos = pos
end
else
AS_SmoothPos = nil
end
if AS_LastRawPitch then
local lx, lz = look.X, look.Z
local hh = lx * lx + lz * lz
local dp = look.Y - AS_LastRawPitch
local dyaw = 0
if AS_LastLX and hh > 0.04 and (AS_LastLX * AS_LastLX + AS_LastLZ * AS_LastLZ) > 0.04 then
local cross = lx * AS_LastLZ - lz * AS_LastLX
dyaw = math.asin(math.clamp(cross / hh, -1, 1))
end
if AntiShake.Oscillation and not aimBusy then
local bandP = math.abs(dp) > 0.0001 and math.abs(dp) < math.rad(2.5)
local bandY = math.abs(dyaw) > 0.0001 and math.abs(dyaw) < math.rad(2.5)
local flipP = bandP and AS_LastDp ~= nil and math.abs(AS_LastDp) < math.rad(2.5) and ((dp > 0) ~= (AS_LastDp > 0))
local flipY = bandY and AS_LastDy ~= nil and math.abs(AS_LastDy) < math.rad(2.5) and ((dyaw > 0) ~= (AS_LastDy > 0))
if flipP then
AS_PitchFlips = AS_PitchFlips + 1
else
AS_PitchFlips = 0
end
if flipY then
AS_YawFlips = AS_YawFlips + 1
else
AS_YawFlips = 0
end
if (flipP or flipY) and firing then
if not AS_AnchorLook then
local back = cf
if bandP then
back = back * CFrame.Angles(-dp, 0, 0)
end
if bandY then
back = back * CFrame.Angles(0, -dyaw, 0)
end
AS_AnchorLook = back.LookVector
end
AS_LastShakeAt = now
FUST_FireUntil = math.max(FUST_FireUntil, now + 0.2)
elseif not bandP and not bandY then
if now - AS_LastShakeAt > 0.25 then
AS_AnchorLook = nil
end
end
if AS_AnchorLook and math.abs(AS_AnchorLook.Y) < 0.999 then
local dotAng = math.acos(math.clamp(cf.LookVector:Dot(AS_AnchorLook), -1, 1))
if dotAng > math.rad(6) then
AS_AnchorLook = nil
elseif dotAng > 0.0006 then
local target = CFrame.lookAt(cf.Position, cf.Position + AS_AnchorLook)
camera.CFrame = cf:Lerp(target, 0.55)
end
end
end
AS_LastDp = dp
