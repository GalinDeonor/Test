-- =============================================================
-- 0.53: ЧАМСЫ МЕБЕЛИ — ВОЗВРАТ из 0.45 (0.39v6, был вырезан в 0.49).
-- Шкафы/ящики/локеры/стеллажи/комоды/кровати/двери. Пул 20 Highlight'ов,
-- подсвечиваются ближайшие. Скан БЕЗ E-15: один раз при включении чанками
-- + новые объекты через DescendantAdded и теги CollectionService.
uiStep("Чамсы мебели", function()
FurnitureChams = { Enabled = false, Color = Color3.fromRGB(100, 200, 255), Transparency = 0.4 }
FURNITURE_PATTERNS = {
"шкаф", "стеллаж", "ящик", "сундук", "контейнер", "локер", "locker",
"металлический шкаф", "metal cabinet", "шкаф для базы", "base cabinet",
"гардероб", "wardrobe", "closet", "полка", "shelf", "комод", "chest",
"тумба", "стол", "table", "стул", "chair", "кровать", "bed", "диван", "couch",
"дверь", "door", "ворота", "gate",
}
FURNITURE_TAGS = { "FustFurniture", "FustContainer", "FustStorage", "Furniture", "Container" }
local furnitureList = {}
local furnitureListSet = {}
local furnitureChamsPool = {}
local furnitureChamsAt = 0
local furnitureScanDone = false
local furniturePoolWanted = false
local function furnitureMatches(name)
local n = string.lower(tostring(name or ""))
if n == "" then
return false
end
for _, pat in ipairs(FURNITURE_PATTERNS) do
if string.find(n, pat, 1, true) then
return true
end
end
return false
end
local function furnitureAdd(inst)
if not inst or not inst.Parent then
return
end
if not (inst:IsA("Model") or inst:IsA("BasePart")) then
return
end
if furnitureListSet[inst] then
return
end
if not inst:IsDescendantOf(Workspace) then
return
end
furnitureListSet[inst] = true
table.insert(furnitureList, inst)
end
local function furnitureScanChunked()
if furnitureScanDone then
return
end
furnitureScanDone = true
task.spawn(function()
if getgenv().FUST_SESSION ~= FUST_SESSION then
return
end
local okD, objs = pcall(function()
return Workspace:GetDescendants()
end)
if not okD or type(objs) ~= "table" then
return
end
local i = 0
for _, d in ipairs(objs) do
if getgenv().FUST_SESSION ~= FUST_SESSION then
return
end
pcall(function()
if d:IsA("Model") or d:IsA("BasePart") then
if furnitureMatches(d.Name) then
furnitureAdd(d)
end
end
end)
i = i + 1
if i % 500 == 0 then
task.wait()
end
end
print("[FUST] МЕБЕЛЬ: первичный скан завершён, найдено: " .. tostring(#furnitureList))
furnitureChamsAt = 0
end)
end
pcall(function()
Library:Connect(Workspace.DescendantAdded, function(inst)
if not FurnitureChams.Enabled then
return
end
task.defer(function()
pcall(function()
if inst and (inst:IsA("Model") or inst:IsA("BasePart")) and furnitureMatches(inst.Name) then
furnitureAdd(inst)
end
end)
end)
end)
end)
local function furnitureChamsTick()
if not FurnitureChams.Enabled then
if furniturePoolWanted then
for i = 1, #furnitureChamsPool do
pcall(function()
furnitureChamsPool[i].Enabled = false
furnitureChamsPool[i].Adornee = nil
end)
end
furniturePoolWanted = false
end
return
end
local now = os.clock()
if now - furnitureChamsAt < 1.5 then
return
end
furnitureChamsAt = now
for i = #furnitureList, 1, -1 do
local inst = furnitureList[i]
if not inst.Parent or not inst:IsDescendantOf(Workspace) then
furnitureListSet[inst] = nil
table.remove(furnitureList, i)
end
end
for _, tag in ipairs(FURNITURE_TAGS) do
local okT, tagged = pcall(CollectionService.GetTagged, CollectionService, tag)
if okT and type(tagged) == "table" then
for _, inst in ipairs(tagged) do
if inst.Parent and (inst:IsA("Model") or inst:IsA("BasePart")) then
furnitureAdd(inst)
end
end
end
end
local myChar = LocalPlayer.Character
local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
local list = {}
if myRoot then
for _, inst in ipairs(furnitureList) do
local okD, d = pcall(function()
return (inst:GetPivot().Position - myRoot.Position).Magnitude
end)
if okD and d then
table.insert(list, { inst = inst, d = d })
end
end
table.sort(list, function(a, b)
return a.d < b.d
end)
else
for _, inst in ipairs(furnitureList) do
table.insert(list, { inst = inst, d = 0 })
end
end
local POOL_MAX = 20
for i = 1, math.min(#list, POOL_MAX) do
local inst = list[i].inst
local h = furnitureChamsPool[i]
if not h then
local okH, created = pcall(function()
local nh = Instance.new("Highlight")
nh.Name = "PETUH_FurnitureChams"
nh.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
nh.FillTransparency = FurnitureChams.Transparency
nh.OutlineTransparency = 0
nh.Parent = Workspace
return nh
end)
if okH and created then
h = created
furnitureChamsPool[i] = created
end
end
if h then
pcall(function()
h.Adornee = inst
h.FillColor = FurnitureChams.Color
h.OutlineColor = FurnitureChams.Color
h.FillTransparency = FurnitureChams.Transparency
h.Enabled = true
end)
if not h.Parent then
-- игра сносит Highlight — чамсы мебели невозможны, глушим честно
FurnitureChams.Enabled = false
furniturePoolWanted = false
if UIRegistry.FurnitureChams and UIRegistry.FurnitureChams.Set then
pcall(function() UIRegistry.FurnitureChams:Set(false) end)
end
warn("[FUST] МЕБЕЛЬ: Highlight сносится игрой — чамсы мебели отключены")
break
end
end
end
for i = math.min(#list, POOL_MAX) + 1, #furnitureChamsPool do
pcall(function()
furnitureChamsPool[i].Enabled = false
furnitureChamsPool[i].Adornee = nil
end)
end
furniturePoolWanted = true
end
task.spawn(function()
while getgenv().FUST_SESSION == FUST_SESSION do
pcall(furnitureChamsTick)
task.wait(0.5)
end
end)
