function npcNameMatches(model, patterns)
local okN, name = pcall(function()
return string.lower(tostring(model.Name))
end)
if not okN then
return false
end
for _, pat in ipairs(patterns) do
if string.find(name, pat, 1, true) then
return true
end
end
return false
end
function npcHasAnyTag(model, tags)
for _, tag in ipairs(tags) do
local okT, has = pcall(CollectionService.HasTag, CollectionService, model, tag)
if okT and has then
return true
end
end
return false
end
function npcInsideFolder(model, names)
local p = model.Parent
local depth = 0
while p and p ~= Workspace and depth < 8 do
for _, n in ipairs(names) do
if p.Name == n then
return true
end
end
p = p.Parent
depth = depth + 1
end
return false
end
function npcHasWeaponInHands(model)
local okT, tool = pcall(function()
return model:FindFirstChildOfClass("Tool")
end)
if okT and tool then
local okN, tname = pcall(function()
return string.lower(tostring(tool.Name))
end)
if okN and tname then
for _, pat in ipairs(WEAPON_PATTERNS) do
if string.find(tname, pat, 1, true) then
return true
end
end
end
end
return false
end
function npcSleeperMarked(model, hum, root)
if npcHasAnyTag(model, SLEEPER_TAGS) then
return true
end
if npcInsideFolder(model, { "Sleepers", "Sleeper", "Bodies", "SleepingPlayers", "Спящие" }) then
return true
end
for _, inst in ipairs({ model, hum, root }) do
if inst then
for _, attr in ipairs(SLEEPER_ATTRS) do
local okA, v = pcall(inst.GetAttribute, inst, attr)
if okA and v == true then
return true
end
end
end
end
local okC, children = pcall(model.GetChildren, model)
if okC and children then
for _, child in ipairs(children) do
if child:IsA("BoolValue") then
local cn = string.lower(tostring(child.Name))
if (string.find(cn, "sleep", 1, true) or string.find(cn, "пящ", 1, true))
and child.Value == true then
return true
end
end
end
end
if npcNameMatches(model, SLEEPER_PATTERNS) then
return true
end
return false
end
function npcGetCategory(model, hum, root)
local now = os.clock()
local cached = npcCategoryCache[model]
if cached and cached.Cat and cached.Expire > now then
local on = (
(cached.Cat == "Guard" and S.NPC.CatGuards)
or (cached.Cat == "Peaceful" and S.NPC.CatPeaceful)
or (cached.Cat == "Animal" and S.NPC.CatAnimals)
or (cached.Cat == "Sleeper" and S.NPC.CatSleepers)
) and true or false
return cached.Cat, on, NPC_CAT_COLORS[cached.Cat] or NPC_COLOR
end
local cat
local inNpcFolder = npcInsideFolder(model, { "Npcs", "NPCs", "NPC" })
or npcHasAnyTag(model, NPC_NPC_TAGS)
local inAnimalFolder = npcInsideFolder(model, { "Animals", "Animal" })
or npcHasAnyTag(model, NPC_ANIMAL_TAGS)
if inAnimalFolder or npcNameMatches(model, ANIMAL_PATTERNS) then
cat = "Animal"
elseif inNpcFolder then
if npcNameMatches(model, GUARD_PATTERNS) or npcHasWeaponInHands(model) then
cat = "Guard"
else
cat = "Peaceful"
end
else
if npcSleeperMarked(model, hum, root) then
cat = "Sleeper"
else
local okU, upDot = pcall(function()
return root and root.CFrame.UpVector:Dot(Vector3.new(0, 1, 0)) or 1
end)
if okU and upDot and upDot < 0.45 then
if not npcHorizontalSince[model] then
npcHorizontalSince[model] = now
end
if now - npcHorizontalSince[model] >= 4 then
cat = "Sleeper"
end
else
npcHorizontalSince[model] = nil
end
if not cat and (npcNameMatches(model, GUARD_PATTERNS) or npcHasWeaponInHands(model)) then
cat = "Guard"
end
if not cat then
cat = "Peaceful"
end
end
end
npcCategoryCache[model] = { Cat = cat, Expire = now + NPC_CAT_TTL }
local on = (
(cat == "Guard" and S.NPC.CatGuards)
or (cat == "Peaceful" and S.NPC.CatPeaceful)
or (cat == "Animal" and S.NPC.CatAnimals)
or (cat == "Sleeper" and S.NPC.CatSleepers)
) and true or false
return cat, on, NPC_CAT_COLORS[cat] or NPC_COLOR
end
