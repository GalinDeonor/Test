function windowedSize(vp)
local w = math.clamp(math.min(900, vp.X - 24), 320, 900)
local h = math.clamp(math.min(600, vp.Y - 90), 240, 600)
w = math.max(200, math.min(w, vp.X - WINDOW_MARGIN * 2))
h = math.max(150, math.min(h, vp.Y - WINDOW_MARGIN * 2))
return math.floor(w), math.floor(h)
end
function clampWindowOnScreen()
pcall(function()
local vp = getViewSize()
local maxW = math.max(200, vp.X - WINDOW_MARGIN * 2)
local maxH = math.max(150, vp.Y - WINDOW_MARGIN * 2)
local w = math.min(MainFrame.Size.X.Offset, maxW)
local h = math.min(MainFrame.Size.Y.Offset, maxH)
MainFrame.Size = UDim2.fromOffset(w, h)
local pos = MainFrame.AbsolutePosition
local x = math.clamp(pos.X, WINDOW_MARGIN, math.max(WINDOW_MARGIN, vp.X - w - WINDOW_MARGIN))
local y = math.clamp(pos.Y, WINDOW_MARGIN, math.max(WINDOW_MARGIN, vp.Y - h - WINDOW_MARGIN))
MainFrame.AnchorPoint = Vector2.new(0, 0)
MainFrame.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
end)
