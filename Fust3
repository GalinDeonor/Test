-- 0.39 FIX: b64decode переписан — старая версия накапливала биты в buffer
-- без маскирования, после ~5 символов переполняла 32 бита и выдавала мусор.
-- Новая версия: обрабатываем по 4 base64-символа → 3 байта, без накопления.
-- 0.39 FIX2: НЕ используем << >> & | побитовые операторы — старые экзекуторы
-- (Delta, старые версии Xeno) их не поддерживают и падают с ошибкой компиляции
-- "Fust:4731". Используем bit32.* (доступно везде с Roblox Luau).
local function b64decode(s)
local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #chars do lookup[chars:byte(i)] = i - 1 end
local out = {}
local i = 1
local len = #s
while i <= len - 3 do
local a = lookup[s:byte(i)] or 0
local b = lookup[s:byte(i + 1)] or 0
local c = lookup[s:byte(i + 2)] or 0
local d = lookup[s:byte(i + 3)] or 0
local b2 = s:byte(i + 2)
local b3 = s:byte(i + 3)
if b2 == 61 then
table.insert(out, string.char(bit32.bor(bit32.lshift(a, 2), bit32.rshift(b, 4))))
break
elseif b3 == 61 then
table.insert(out, string.char(bit32.bor(bit32.lshift(a, 2), bit32.rshift(b, 4))))
table.insert(out, string.char(bit32.bor(bit32.lshift(bit32.band(b, 0xF), 4), bit32.rshift(c, 2))))
break
else
table.insert(out, string.char(bit32.bor(bit32.lshift(a, 2), bit32.rshift(b, 4))))
table.insert(out, string.char(bit32.bor(bit32.lshift(bit32.band(b, 0xF), 4), bit32.rshift(c, 2))))
table.insert(out, string.char(bit32.bor(bit32.lshift(bit32.band(c, 0x3), 6), d)))
end
i = i + 4
end
return table.concat(out)
end
