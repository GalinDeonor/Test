Name = "Проверка видимости (за стеной — серый)",
Flag = "ESPVisCheck",
Default = false,
Callback = function(state)
S.ESP.VisCheck = state
espVisCacheClear()
journal("ESP ВИДИМОСТЬ " .. (state and "ВКЛ (за стеной — серый + «СТЕНА»)" or "ВЫКЛ"))
end
})
UIRegistry.ESPVisHitbox = EspSection:Toggle({
Name = "Показывать хитбокс-доступ (жёлтый, если торчит)",
Flag = "ESPVisHitbox",
Default = false,
Callback = function(state)
S.ESP.VisHitbox = state
espVisCacheClear()
journal("ESP ХИТБОКС-ДОСТУП " .. (state and "ВКЛ (жёлтый = виден только хитбокс)" or "ВЫКЛ"))
end
})
EspSection:Label("Видимость смотрит ТЕЛО (хитбоксы игнор). Жёлтый = тело за стеной, но хитбокс торчит. Серый + «СТЕНА» = не подстрелить.")
HudSection = EspPage:Section({ Name = "HUD на экране", Tab = "ESP", Side = 2 })
hudGui = nil 
hudFrame = nil 
hudStroke = nil
hudLineFPS, hudLinePing, hudLineTPS, hudLinePlayers, hudLineAdmin = nil, nil, nil, nil, nil
hudConns = {} 
hudDragging = false
hudDragStart, hudFrameStart = nil, nil
HUD_MARGIN = 12
function hudSnap(corner)
if not hudFrame then
return
end
local ax = (corner and string.find(corner, "Право", 1, true)) and 1 or 0
local ay = (corner and string.find(corner, "верх", 1, true)) and 0 or 1
local ox = (ax == 1) and -HUD_MARGIN or HUD_MARGIN
local oy = (ay == 1) and -HUD_MARGIN or HUD_MARGIN
hudFrame.AnchorPoint = Vector2.new(ax, ay)
