end
local camera = Workspace.CurrentCamera
if not camera then return end
-- 0.56: персонаж НЕ трогается каждый кадр (было: якорь + перезапись CFrame
-- + обнуление скоростей — именно такое состояние и ловит анти-чит, E-19)
local rotCFrame = CFrame.Angles(0, math.rad(camYaw), 0) * CFrame.Angles(math.rad(camPitch), 0, 0)
local moveVector = Vector3.zero
if joystickVector.Magnitude > 0.05 then
local right = rotCFrame.RightVector * joystickVector.X
local forward = rotCFrame.LookVector * joystickVector.Y
moveVector = moveVector + right + forward
end
-- 0.57 (E-22): СТРЕЛКИ = обзор камеры (работают всегда, через опрос).
if fcKey("Left", Enum.KeyCode.Left) then camYaw = camYaw + 140 * dt end
if fcKey("Right", Enum.KeyCode.Right) then camYaw = camYaw - 140 * dt end
if fcKey("Up", Enum.KeyCode.Up) then camPitch = math.clamp(camPitch + 90 * dt, -89, 89) end
if fcKey("Down", Enum.KeyCode.Down) then camPitch = math.clamp(camPitch - 90 * dt, -89, 89) end
local kbForward = 0
local kbRight = 0
local kbUp = 0
if fcKey("W", Enum.KeyCode.W) then kbForward = kbForward + 1 end
if fcKey("S", Enum.KeyCode.S) then kbForward = kbForward - 1 end
if fcKey("D", Enum.KeyCode.D) then kbRight = kbRight + 1 end
if fcKey("A", Enum.KeyCode.A) then kbRight = kbRight - 1 end
if fcKey("E", Enum.KeyCode.E) or fcKey("Space", Enum.KeyCode.Space) then kbUp = kbUp + 1 end
if fcKey("Q", Enum.KeyCode.Q) or fcKey("LCtrl", Enum.KeyCode.LeftControl) then kbUp = kbUp - 1 end
if kbForward ~= 0 or kbRight ~= 0 or kbUp ~= 0 then
local pcMove = (rotCFrame.LookVector * kbForward) + (rotCFrame.RightVector * kbRight) + (Vector3.new(0, 1, 0) * kbUp)
moveVector = moveVector + pcMove
end
if moveVector.Magnitude > 0 then
local currentMultiplier = (keysDown.LeftShift or fcKey("LeftShift", Enum.KeyCode.LeftShift) or fcKey("RightShift", Enum.KeyCode.RightShift)) and 2.0 or 1.0
camPos = camPos + (moveVector.Unit * (flySpeed * currentMultiplier * dt))
end
camera.CFrame = CFrame.new(camPos) * rotCFrame
end)
