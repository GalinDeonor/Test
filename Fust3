-- 0.56: персонаж НЕ трогается каждый кадр (было: якорь + перезапись CFrame
-- + обнуление скоростей — именно такое состояние и ловит анти-чит, E-19)
local rotCFrame = CFrame.Angles(0, math.rad(camYaw), 0) * CFrame.Angles(math.rad(camPitch), 0, 0)
local moveVector = Vector3.zero
if joystickVector.Magnitude > 0.05 then
local right = rotCFrame.RightVector * joystickVector.X
local forward = rotCFrame.LookVector * joystickVector.Y
moveVector = moveVector + right + forward
end
local kbForward = 0
local kbRight = 0
local kbUp = 0
if keysDown.W then kbForward = kbForward + 1 end
if keysDown.S then kbForward = kbForward - 1 end
if keysDown.D then kbRight = kbRight + 1 end
if keysDown.A then kbRight = kbRight - 1 end
if keysDown.E then kbUp = kbUp + 1 end
if keysDown.Q then kbUp = kbUp - 1 end
if kbForward ~= 0 or kbRight ~= 0 or kbUp ~= 0 then
local pcMove = (rotCFrame.LookVector * kbForward) + (rotCFrame.RightVector * kbRight) + (Vector3.new(0, 1, 0) * kbUp)
moveVector = moveVector + pcMove
end
if moveVector.Magnitude > 0 then
local currentMultiplier = keysDown.LeftShift and 2.0 or 1.0
camPos = camPos + (moveVector.Unit * (flySpeed * currentMultiplier * dt))
end
camera.CFrame = CFrame.new(camPos) * rotCFrame
end)
end
