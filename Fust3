function translateItemName(name)
if not ItemRuTranslate or type(name) ~= "string" then
return name
end
local nl = string.lower(name)
-- точное совпадение
if ITEM_RU_DICT[nl] then
return ITEM_RU_DICT[nl]
end
-- частичное совпадение по подстроке
for eng, rus in pairs(ITEM_RU_DICT) do
if string.find(nl, eng, 1, true) then
return rus
end
end
return name
end
