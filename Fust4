end)
end
xrayConn = Workspace.DescendantAdded:Connect(function(o)
pcall(xrayReg, o)
if XRay.Enabled and (o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation")) and xrayNameHit(o) then
o.Transparency = XRay.Transparency
