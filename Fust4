-- 0.64: ======== АНТИ-АФК ========
-- Roblox кикает через ~20 минут бездействия. Слушаем LocalPlayer.Idled и
-- имитируем активность через VirtualUser (стандартный сервис Roblox, НЕ
-- хук) — за бездействие больше не выкидывает. Работает на Delta и Xeno.
if getgenv().FUST_AntiAFKCleanup then
pcall(getgenv().FUST_AntiAFKCleanup)
end
AntiAFK = { Enabled = false, Conn = nil }
function antiAfkSet(on)
if on then
if AntiAFK.Conn then return end
AntiAFK.Conn = Library:Connect(LocalPlayer.Idled, function()
pcall(function()
local VU = game:GetService("VirtualUser")
VU:CaptureController()
VU:SetButton2(1)
task.wait(1)
VU:SetButton2(0)
end)
journal("АНТИ-АФК: сымитирована активность (кик за AFK предотвращён)")
end)
else
if AntiAFK.Conn then
pcall(function()
if AntiAFK.Conn.Connection then
AntiAFK.Conn.Connection:Disconnect()
end
end)
AntiAFK.Conn = nil
end
end
end
getgenv().FUST_AntiAFKCleanup = function()
AntiAFK.Enabled = false
if AntiAFK.Conn then
pcall(function()
if AntiAFK.Conn.Connection then
AntiAFK.Conn.Connection:Disconnect()
end
end)
AntiAFK.Conn = nil
end
