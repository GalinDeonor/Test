end
local size = math.clamp(math.floor((S.HUD.Size or 11) + 0.5), 8, 16)
local textT = math.clamp(S.HUD.TextTransparency or 0, 0, 0.9)
for _, line in ipairs({ hudLineFPS, hudLinePing, hudLineTPS, hudLinePlayers }) do
if line then
line.TextSize = size
line.TextTransparency = textT
end
end
local bg = math.clamp(S.HUD.BgTransparency or 0.35, 0, 0.95)
if S.HUD.ShowBg then
hudFrame.BackgroundTransparency = bg
if hudStroke then
hudStroke.Transparency = math.clamp(bg + 0.25, 0, 1)
end
else
hudFrame.BackgroundTransparency = 1
if hudStroke then
hudStroke.Transparency = 1
end
end
if hudLineTPS then
hudLineTPS.Visible = S.HUD.ShowTPS and true or false
end
end
