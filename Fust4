-- 0.50: X-RAY — просвет стен-строений (twig). Взят из VOMAGLA (open source),
-- адаптирован под «Пьяного Петуха». Клиентский LocalTransparencyModifier не
-- используется — меняем Transparency напрямую с запоминанием оригинала
-- (как в VOMAGLA). Сервер НЕ видит изменение Transparency чужих частей —
-- свойство не реплицируется с клиента, анти-читу не на что детектить.
XRay = { Enabled = false, Transparency = 0.5 }
-- 0.54: ключ "Twig" ловит ЛЮБЫЕ twig-объекты (включая новые имена игры),
-- остальные — для читаемости
-- 0.58 (E-23): +строительные ключи и РУССКИЕ («Стен», «Двер», «Крыш»...).
-- Матч БЕЗ УЧЁТА РЕГИСТРА: стены могли называться «wall»/«TWIG» строчными
-- и не ловились (двери с «Door» в нужном регистре ловились — отсюда
-- «прозрачные только двери»).
XRAY_KEYWORDS = { "Twig", "Wood", "Plank", "Board", "Wall", "Roof", "Floor", "Foundation", "Ramp", "Stairs", "Fence", "Frame", "Window", "Door", "Gate", "Panel", "Stone", "Metal", "Block", "Ceil", "Pillar", "Beam", "Slab", "Glass", "Стен", "Двер", "Крыш", "Фундамент", "Забор", "Окн", "Перекрыт", "Лестниц", "Постройк", "Блок" }
XRAY_KEYWORDS_LOWER = {}
for _, xk in ipairs(XRAY_KEYWORDS) do
XRAY_KEYWORDS_LOWER[#XRAY_KEYWORDS_LOWER + 1] = string.lower(xk)
end
local xrayCache = setmetatable({}, { __mode = "k" }) -- 0.51 (E-15): слабые ключи — убитые части не копятся в памяти
local xrayConn = nil
local function xrayIsTwig(name)
if type(name) ~= "string" or name == "" then return false end
local nl = string.lower(name)
for _, k in ipairs(XRAY_KEYWORDS_LOWER) do
if string.find(nl, k, 1, true) then return true end
end
return false
end
-- 0.55: ГЛАВНЫЙ ФИКС «X-Ray не работает»: раньше матчили ТОЛЬКО имя парта.
-- В FUST постройки — модели, у дочерних парта имена общие (Part/Union),
-- twig в имени НЕТ. Теперь проверяем имя парта И имена моделей-родителей
-- (2 уровня вверх).
local function xrayNameHit(o)
if xrayIsTwig(o.Name) then return true end
local mp = o.Parent
-- 0.58 (E-23): 2 -> 4 уровня родителей — части стен могут лежать глубже
for _ = 1, 4 do
if not mp or mp == Workspace then break end
if xrayIsTwig(mp.Name) then return true end
mp = mp.Parent
end
return false
end
local function xrayReg(o)
if xrayCache[o] then return end
if (o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation")) and xrayNameHit(o) then
xrayCache[o] = { OT = o.Transparency }
end
end
function setXrayState(on, t)
for p, d in pairs(xrayCache) do
if p and p.Parent and p:IsDescendantOf(Workspace) then
p.Transparency = on and t or d.OT
else
xrayCache[p] = nil
end
end
end
-- пере-запуск скрипта: глушим старый коннект и возвращаем стены
if getgenv().FUST_XRayCleanup then
pcall(getgenv().FUST_XRayCleanup)
end
getgenv().FUST_XRayCleanup = function()
pcall(function()
if xrayConn then xrayConn:Disconnect() xrayConn = nil end
end)
pcall(setXrayState, false, 0.5)
-- 0.55: дикий режим тоже возвращаем (setWildXrayState — глобальная,
-- к моменту вызова уже определена ниже)
pcall(setWildXrayState, false, 0.5)
end
-- 0.51 FIX (E-15): стартовый скан ВСЕГО Workspace БЕЗ единого yield
-- блокировал планировщик Roblox: рендер стоял за чёрным сплэшем, Android
-- вешал/убивал приложение (Xeno на ПК проходил скан за 1-2 сек и не
-- замечал). При старте СКАНА БОЛЬШЕ НЕТ: регистрация идёт через
-- DescendantAdded ниже, а полный скан — ТОЛЬКО по тумблеру X-Ray,
-- чанками по 2000 объектов с task.wait() (рендер не замирает).
local xrayScanRunning = false
function xrayScanAll(onDone)
if xrayScanRunning then return end
xrayScanRunning = true
task.spawn(function()
-- 0.54: скан в pcall — даже если упал, флаг xrayScanRunning сбросится
-- и следующие включения X-Ray не станут «тихо ничего не делать»
local okScan, scanErr = pcall(function()
local objs = Workspace:GetDescendants()
local n = #objs
local i = 0
for _, o in ipairs(objs) do
pcall(xrayReg, o)
-- 0.54: прозрачность применяется ПРЯМО ПО ХОДУ скана — стены
-- становятся прозрачными сразу, а не разом через 1-3 сек
if XRay.Enabled and (o:IsA("BasePart") or o:IsA("MeshPart") or o:IsA("UnionOperation")) and xrayNameHit(o) then
o.Transparency = XRay.Transparency
end
i = i + 1
if i % 2000 == 0 then
task.wait()
end
end
journal("X-RAY: скан карты завершён (" .. tostring(n) .. " объектов)")
end)
if not okScan then
journal("X-RAY: ошибка скана — " .. tostring(scanErr))
