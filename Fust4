local okN, name = pcall(function() return string.lower(tostring(d.Name)) end)
if okN then
for _, pat in ipairs(FURNITURE_PATTERNS) do
if string.find(name, pat, 1, true) then
table.insert(found, d)
break
end
end
end
-- проверяем детей модели
for _, child in ipairs(d:GetChildren()) do
if child:IsA("Model") or child:IsA("BasePart") then
local okN2, name2 = pcall(function() return string.lower(tostring(child.Name)) end)
if okN2 then
for _, pat in ipairs(FURNITURE_PATTERNS) do
if string.find(name2, pat, 1, true) then
table.insert(found, child)
break
end
end
end
end
end
end
end
end)
