-- 0.63: СМЕНА FOV (ПОЛЕ ЗРЕНИЯ) — идея из найденного тобой исходника
-- (Fust Survival Fucker), реализовано БЕЗ ХУКОВ: меняем только свойство
-- FieldOfView камеры (как FOV-ченджер в том исходнике, но безопасно).
-- Больше FOV = шире обзор, меньше = приближение. Бэкап значения при
-- включении, возврат при выключении, переживает замену CurrentCamera.
FOVCam = { Enabled = false, Value = 70 }
local fovCamBackup = nil
local function fovCamGet()
local c = Workspace.CurrentCamera
if not c then return nil end
local ok, isCam = pcall(function() return c:IsA("Camera") end)
if ok and isCam then return c end
return nil
end
function fovCamApply()
if not FOVCam.Enabled then return end
local c = fovCamGet()
if c then
pcall(function() c.FieldOfView = FOVCam.Value end)
end
end
function fovCamSetEnabled(on)
local c = fovCamGet()
if on then
if not FOVCam.Enabled and c then
local okB, cur = pcall(function() return c.FieldOfView end)
if okB and type(cur) == "number" and cur > 1 and cur < 170 then
fovCamBackup = cur
end
end
FOVCam.Enabled = true
fovCamApply()
else
FOVCam.Enabled = false
if c and fovCamBackup then
pcall(function() c.FieldOfView = fovCamBackup end)
end
fovCamBackup = nil
end
end
-- перезапуск скрипта: старая сессия возвращает FOV и сбрасывает флаг
if getgenv().FUST_FOVCamCleanup then
pcall(getgenv().FUST_FOVCamCleanup)
end
-- перезапуск скрипта: старый якорь заморозки снимаем (0.66)
if getgenv().FUST_FreezeCleanup then
