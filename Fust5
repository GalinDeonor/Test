function autoAimTick()
if not AutoAim.Enabled then
AA_EnemyNear = false
AA_NearestDist = nil
return
end
local myChar = LocalPlayer.Character
local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
if not myRoot then
return 
end
local bestDist = math.huge
local bestName = nil
for _, plr in ipairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and Whitelist[plr.Name] == nil then
local model = plr.Character
local hum = model and model:FindFirstChildOfClass("Humanoid")
local root = model and model:FindFirstChild("HumanoidRootPart")
if hum and root and hum.Health > 0 then
local d = (root.Position - myRoot.Position).Magnitude
if d < bestDist then
bestDist = d
bestName = plr.Name
end
end
end
end
AA_NearestDist = (bestDist < math.huge) and bestDist or nil
local want = AA_EnemyNear
if want then
if bestDist > AutoAim.Radius + 30 then
want = false 
end
else
if bestDist <= AutoAim.Radius then
want = true 
end
end
if want ~= AA_EnemyNear then
AA_EnemyNear = want
if UIRegistry.AimEnabled and UIRegistry.AimEnabled.Set then
pcall(function()
UIRegistry.AimEnabled:Set(want)
end)
end
if bestName then
journal(string.format("АВТО-АИМ: %s — %s (%d м)",
want and "ВРАГ В РАДИУСЕ, АИМБОТ ВКЛЮЧЕН" or "ВРАГ УШЁЛ, АИМБОТ ВЫКЛЮЧЕН",
bestName, math.floor(bestDist + 0.5)))
else
journal("АВТО-АИМ: " .. (want and "АИМБОТ ВКЛЮЧЕН" or "АИМБОТ ВЫКЛЮЧЕН"))
end
end
end
