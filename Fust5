-- 0.53: ДВИЖОК ПРИЦЕЛА ИЗ VOMAGLA (1-в-1): крест из 4 Drawing-линий,
-- вращение, пульс зазора, радуга, точка-квадрат, следование за целью
-- или за точкой аима (гладко, через exp-лерп). Старый CS2-прицел убран.
CH = {
Enabled = false,
Color = Color3.new(1, 1, 1),
Rainbow = false,
Length = 8,
Gap = 4,
Thickness = 1.5,
Dot = false,
RotationSpeed = 0,
Pulse = false,
PulseSpeed = 3,
FollowTarget = false,
FollowSmooth = 8,
FollowAimPoint = false,
}
chLines = {}
for i = 1, 4 do
local l = SafeDrawing("Line")
if l then
l.Visible = false
l.Thickness = CH.Thickness
l.Color = CH.Color
chLines[i] = l
end
end
chDot = SafeDrawing("Square")
if chDot then
chDot.Visible = false
chDot.Filled = true
chDot.Thickness = 1
chDot.Size = Vector2.new(2, 2)
chDot.Color = CH.Color
end
local chSmoothX, chSmoothY = nil, nil
local chElapsed = 0
local chRot = 0
AIM_TargetPart = nil
AIM_TargetScreenPos = nil
function updateCrosshairV(dt, center)
if not chLines[1] then
return
end
if not CH.Enabled then
for _, l in ipairs(chLines) do
l.Visible = false
end
if chDot then
chDot.Visible = false
end
return
end
local camera = Workspace.CurrentCamera
if not camera then
return
end
local vp = camera.ViewportSize
local cx, cy = center.X, center.Y
if CH.FollowAimPoint and AIM_TargetScreenPos then
cx, cy = AIM_TargetScreenPos.X, AIM_TargetScreenPos.Y
elseif CH.FollowTarget and AIM_TargetPart and AIM_TargetPart.Parent then
local okS, sp, vis = pcall(function()
local s, v = camera:WorldToViewportPoint(AIM_TargetPart.Position)
return s, v
end)
if okS and sp and vis then
cx, cy = sp.X, sp.Y
elseif okS and sp then
-- цель за спиной — прижимаем прицел к краю экрана (как в VOMAGLA)
local dx, dy = sp.X - cx, sp.Y - cy
local adx, ady = math.abs(dx), math.abs(dy)
local margin = 18
local sx = (vp.X * 0.5) - margin
local sy = (vp.Y * 0.5) - margin
local scale = 1
if adx > 0 or ady > 0 then
scale = math.min(sx / math.max(adx, 1e-6), sy / math.max(ady, 1e-6))
end
cx, cy = cx + dx * scale, cy + dy * scale
end
end
local smooth = math.clamp(CH.FollowSmooth, 1, 20)
local a = 1 - math.exp(-(dt or 0.016) * smooth)
if chSmoothX == nil then
chSmoothX, chSmoothY = cx, cy
end
chSmoothX = chSmoothX + (cx - chSmoothX) * a
chSmoothY = chSmoothY + (cy - chSmoothY) * a
chElapsed = chElapsed + (dt or 0.016)
