local function safeConn(remote, fn)
if remote and remote:IsA("RemoteEvent") then
pcall(function() remote.OnClientEvent:Connect(fn) end)
end
end
safeConn(gunHit, function(...)
local args = table.pack(...)
local victimChar, hitPart, dmg = nil, nil, nil
for i = 1, args.n do
local v = args[i]
if typeof(v) == "Instance" then
if v:IsA("BasePart") then
hitPart = hitPart or v
victimChar = victimChar or v:FindFirstAncestorOfClass("Model")
elseif v:IsA("Model") then
victimChar = victimChar or v
end
elseif typeof(v) == "number" then
dmg = dmg or v
end
end
local plr = victimChar and Players:GetPlayerFromCharacter(victimChar)
if not plr or plr == LocalPlayer then return end
hitsOnDamaged(plr, victimChar, dmg, hitPart)
end)
