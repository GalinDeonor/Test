return string.lower(tostring(prompt.ObjectText)) .. " " .. tostring(prompt.ActionText)
end)
if not okT or not txt then
return false
end
return bpMatchesFragments(txt, BP_PROMPT_PATTERNS)
end
function bpIsEligibleInstance(inst)
if not inst or not inst.Parent then
return false
end
if not inst:IsA("Model") and not inst:IsA("BasePart") then
return false
end
if not inst:IsDescendantOf(Workspace) then
return false
end
local cam = Workspace.CurrentCamera
if cam and inst:IsDescendantOf(cam) then
return false
end
for _, plr in ipairs(Players:GetPlayers()) do
local c = plr.Character
if c and (c == inst or inst:IsDescendantOf(c)) then
return false
end
end
if trackedNPCs[inst] then
return false
end
if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
return false
end
return true
end
function bpClassify(inst)
local nameL = bpNameLower(inst)
if bpMatchesFragments(nameL, CT_NAME_PATTERNS) then
return "cont"
end
if bpMatchesFragments(nameL, BP_NAME_PATTERNS) then
return "bag"
end
local okP, prompt = pcall(function()
return inst:FindFirstChildOfClass("ProximityPrompt")
end)
if okP and prompt then
local okT, txt = pcall(function()
return string.lower(tostring(prompt.ObjectText)) .. " " .. tostring(prompt.ActionText)
end)
if okT and txt then
if bpMatchesFragments(txt, CT_PROMPT_PATTERNS) then
return "cont"
end
if bpMatchesFragments(txt, BP_PROMPT_PATTERNS) then
return "bag"
end
end
end
return nil
end
function bpTryTrack(inst)
if trackedBackpacks[inst] then
return
end
if not bpIsEligibleInstance(inst) then
return
end
local cat = bpClassify(inst)
if cat then
trackedBackpacks[inst] = { Cat = cat }
end
end
function bpScanContainer(root, maxDepth)
local function walk(parent, depth)
if depth > maxDepth then
return
end
local okC, kids = pcall(function()
return parent:GetChildren()
end)
if not okC or type(kids) ~= "table" then
return
end
for _, ch in ipairs(kids) do
if ch:IsA("Model") or ch:IsA("BasePart") then
bpTryTrack(ch)
end
if ch:IsA("Folder") or (ch:IsA("Model") and depth < 2) then
walk(ch, depth + 1)
end
end
end
walk(root, 1)
end
