end
function bpMatchesFragments(text, patterns)
for _, pat in ipairs(patterns) do
if string.find(text, pat, 1, true) then
return true
end
local up = string.upper(pat)
if up ~= pat and string.find(text, up, 1, true) then
return true
end
end
return false
end
function bpCheckPromptText(prompt)
