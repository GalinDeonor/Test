unction updateCrosshair(center, visible)
local gap = CH.Gap
local len = CH.Length
local th = CH.Thickness
local alpha = CH.Alpha or 1
-- 0.39v2: T-style — верхняя линия не рисуется (как AWP)
-- top (skipped if TStyle)
if chLines[1] and not CH.TStyle then
chLines[1].From = Vector2.new(center.X, center.Y - gap)
chLines[1].To = Vector2.new(center.X, center.Y - gap - len)
chLines[1].Thickness = th
chLines[1].Color = CH.Color
chLines[1].Transparency = 1 - alpha
chLines[1].Visible = visible
elseif chLines[1] then
chLines[1].Visible = false
end
-- bottom
if chLines[2] then
chLines[2].From = Vector2.new(center.X, center.Y + gap)
chLines[2].To = Vector2.new(center.X, center.Y + gap + len)
chLines[2].Thickness = th
chLines[2].Color = CH.Color
chLines[2].Transparency = 1 - alpha
chLines[2].Visible = visible
end
-- left
if chLines[3] then
chLines[3].From = Vector2.new(center.X - gap, center.Y)
chLines[3].To = Vector2.new(center.X - gap - len, center.Y)
chLines[3].Thickness = th
chLines[3].Color = CH.Color
chLines[3].Transparency = 1 - alpha
chLines[3].Visible = visible
end
-- right
if chLines[4] then
chLines[4].From = Vector2.new(center.X + gap, center.Y)
chLines[4].To = Vector2.new(center.X + gap + len, center.Y)
chLines[4].Thickness = th
chLines[4].Color = CH.Color
chLines[4].Transparency = 1 - alpha
chLines[4].Visible = visible
end
-- точка (размер через DotSize)
if chDot then
chDot.Position = center
chDot.Radius = math.max(1, CH.DotSize or 1)
chDot.Color = CH.Color
chDot.Transparency = 1 - alpha
chDot.Visible = visible and CH.Dot
end
-- обводка (8 линий с микро-смещением вокруг основных; толщина через OutlineThickness)
if CH.Outline and visible then
local ot = CH.OutlineThickness or 1
local offs = { {1,0}, {-1,0}, {0,1}, {0,-1} }
local oi = 1
for dir = 1, 4 do
local base = chLines[dir]
if base and base.Visible then
for _, off in ipairs(offs) do
local o = chOutline[oi]
if o then
o.From = Vector2.new(base.From.X + off[1] * ot, base.From.Y + off[2] * ot)
o.To = Vector2.new(base.To.X + off[1] * ot, base.To.Y + off[2] * ot)
o.Thickness = th + ot * 2
o.Color = Color3.fromRGB(0, 0, 0)
o.Transparency = 1 - alpha
o.Visible = true
end
oi = oi + 1
end
end
end
for i = oi, 8 do
if chOutline[i] then chOutline[i].Visible = false end
end
else
for i = 1, 8 do
if chOutline[i] then chOutline[i].Visible = false end
end
end
end
