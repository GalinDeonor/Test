local sy = (vp.Y * 0.5) - margin
local scale = 1
if adx > 0 or ady > 0 then
scale = math.min(sx / math.max(adx, 1e-6), sy / math.max(ady, 1e-6))
end
cx, cy = cx + dx * scale, cy + dy * scale
end
