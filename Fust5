-- < 30м → 0.92 (быстрая коррекция, цель близко — резче)
-- 30..80м → 0.85 (средне)
-- > 80м → 0.78 (далеко — меньше перелётов)
-- Snipe-режим — +0.06 ко всем (максимум 0.98).
local dist = (aimPos - camera.CFrame.Position).Magnitude
local baseA = 0.78
if dist < 30 then baseA = 0.92
elseif dist < 80 then baseA = 0.85
end
if Evil.Snipe then baseA = math.min(0.98, baseA + 0.06) end
-- 0.39v2: КОРРЕКЦИЯ ПЕРЕЛЁТА. Если угол между текущим LookVector и
-- aimPos уже маленький (цель почти в прицеле) — уменьшаем alpha,
-- чтобы не проскочить. Если угол большой — alpha максимум.
local currentLook = camera.CFrame.LookVector
local toAim = (aimPos - camera.CFrame.Position).Unit
local dot = currentLook:Dot(toAim)
if dot > 0.98 then
-- уже почти навелись — плавная коррекция
baseA = baseA * 0.5
end
camera.CFrame = camera.CFrame:Lerp(newCF, baseA)
else
local alpha = math.clamp(1 / math.max(Aim.Smooth, 1), 0, 1)
camera.CFrame = camera.CFrame:Lerp(newCF, alpha)
end
