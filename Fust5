function bpSlotsFromUiText(text)
if type(text) ~= "string" or #text > 40 then
return nil
end
local t = string.lower(text)
if string.find(t, "счез", 1, true) or string.find(t, "ерез", 1, true)
or string.find(t, "xpire", 1, true) or string.find(t, "espawn", 1, true)
or string.find(t, "lapse", 1, true) or string.find(t, "кг", 1, true)
or string.find(t, "kg", 1, true) or string.find(t, "вес", 1, true)
or string.find(t, "weight", 1, true) or string.find(t, "минут", 1, true)
or string.find(t, "хп", 1, true) or string.find(t, "hp", 1, true) then
return nil
end
local u, m = string.match(text, "^%s*(%d+)%s*/%s*(%d+)%s*$")
if u and m then
return u .. "/" .. m
end
u, m = string.match(text, "(%d+)%s+из%s+(%d+)")
or string.match(text, "(%d+)%s+Из%s+(%d+)")
or string.match(text, "(%d+)%s+ИЗ%s+(%d+)")
if u and m then
return u .. "/" .. m
end
if #text <= 16 then
u, m = string.match(text, "(%d+)%s*/%s*(%d+)")
if u and m then
return u .. "/" .. m
end
end
return nil
end
