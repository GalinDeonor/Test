if r and (r.Position - origin).Magnitude < 6 then
return true
end
end
end
return false
end
function btCreateTrace(startPos, endPos)
if not S.Bullets.Enabled then
return
end
local camera = Workspace.CurrentCamera
if camera then
local d = (startPos - camera.CFrame.Position).Magnitude
if d < 4 then
startPos = (camera.CFrame * CFrame.new(2.5, -1.5, -1)).Position
end
end
local p = btGet()
p.Parent = Workspace
local a0 = p:FindFirstChild("A0")
local a1 = p:FindFirstChild("A1")
if a0 then
a0.WorldPosition = startPos
end
if a1 then
a1.WorldPosition = endPos
end
local b = p:FindFirstChild("B")
if not b then
btRelease(p)
return
end
b.Color = ColorSequence.new(S.Bullets.Color)
b.Transparency = NumberSequence.new(S.Bullets.Transparency)
b.Texture = S.Bullets.TextureID
b.Width0 = S.Bullets.Width
b.Width1 = S.Bullets.Width
b.Enabled = true
btActive[#btActive + 1] = { p = p, b = b, start = os.clock() }
end
function FUST_TracersUpdate()
if #btActive == 0 then
return
end
local lt = math.max(S.Bullets.LifeTime or 0.5, 0.05)
local nowT = os.clock()
for i = #btActive, 1, -1 do
local t = btActive[i]
local p, b = t.p, t.b
if not p or not p.Parent then
table.remove(btActive, i)
else
local alpha = 1 - ((nowT - t.start) / lt)
if alpha <= 0 then
btRelease(p, b)
table.remove(btActive, i)
elseif b then
b.Transparency = NumberSequence.new(alpha * S.Bullets.Transparency)
end
end
end
end
