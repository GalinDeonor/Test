local a = 1 - math.exp(-(dt or 0.016) * smooth)
if chSmoothX == nil then
chSmoothX, chSmoothY = cx, cy
end
chSmoothX = chSmoothX + (cx - chSmoothX) * a
chSmoothY = chSmoothY + (cy - chSmoothY) * a
chElapsed = chElapsed + (dt or 0.016)
chRot = (chRot + (dt or 0.016) * CH.RotationSpeed) % 360
