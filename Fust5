function hitsSpawnMarker(worldPos, isKill)
if not Hits.HM or not worldPos then return end
pcall(function()
local lines = {}
local count = 0
for i = 1, 4 do
local l = SafeDrawing("Line")
if l then
l.Visible = false
l.Thickness = Hits.HMThickness
l.ZIndex = 5
lines[i] = l
count = count + 1
end
end
if count == 4 then
hmQueue[#hmQueue + 1] = { pos = worldPos, born = os.clock(), isKill = isKill, lines = lines }
else
for _, l in pairs(lines) do pcall(function() l:Remove() end) end
end
end)
end
