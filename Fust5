local hitsLastHit = setmetatable({}, { __mode = "k" })
local hitsDeathSeen = setmetatable({}, { __mode = "k" })
local function hitsIsOurDamage(plr)
if not plr or plr == LocalPlayer then return false end
if Whitelist[plr.Name] then return false end
if AIM_LastTargetPlayer == plr and (os.clock() - AIM_LastTargetTime) <= 1.25 then
return true
end
return false
end
local function hitsOnDamaged(plr, victimChar, dmg, hitPart)
if not Hits.HM and not Hits.Log and not Hits.Sound then return end
pcall(function()
if not hitsIsOurDamage(plr) then return end
local dmgNum = tonumber(dmg) or 0
if dmgNum <= 0 then return end
local hum = victimChar:FindFirstChildWhichIsA("Humanoid")
local newHealth = hum and hum.Health or 0
local part = hitPart or victimChar:FindFirstChild("HumanoidRootPart") or victimChar:FindFirstChild("Head")
if not part then return end
hitsLastHit[plr] = os.clock()
if Hits.Sound then hitsPlaySound(Hits.SoundChoice) end
if Hits.HM and part.Position then hitsSpawnMarker(part.Position, false) end
if Hits.Log then
hitsShowLog(plr.DisplayName, part.Name, string.format("%.0f", dmgNum), string.format("%.0f", newHealth), newHealth <= 0)
end
end)
end
local function hitsOnDied(plr, char)
pcall(function()
local now = os.clock()
if hitsDeathSeen[plr] and now - hitsDeathSeen[plr] <= 1.5 then return end
hitsDeathSeen[plr] = now
if hitsLastHit[plr] and (now - hitsLastHit[plr]) <= 6 then
if Hits.KillChoice ~= "None" then hitsPlaySound(Hits.KillChoice) end
local root = char and char:FindFirstChild("HumanoidRootPart")
if Hits.HM and root then hitsSpawnMarker(root.Position, true) end
journal("ХИТЫ: УБИЙСТВО " .. tostring(plr.DisplayName))
end
end)
end
do
local deathConns = setmetatable({}, { __mode = "k" })
local function hitsTrackDeath(plr)
if plr == LocalPlayer then return end
local function bind(char)
task.spawn(function()
pcall(function()
local h = char:WaitForChild("Humanoid", 10)
if not h then return end
if deathConns[h] then pcall(function() deathConns[h]:Disconnect() end) end
deathConns[h] = h.Died:Connect(function()
hitsOnDied(plr, char)
end)
end)
end)
end
if plr.Character then bind(plr.Character) end
pcall(function()
plr.CharacterAdded:Connect(bind)
end)
end
for _, p in ipairs(Players:GetPlayers()) do hitsTrackDeath(p) end
