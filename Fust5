"^%s*(.-)s%s*backpack%s*$", 
"^%s*(.-)%s+backpack%s*$", 
"^%s*(.-)'s%s*loot%s*bag%s*$",
"^%s*(.-)s%s*loot%s*bag%s*$",
"^%s*(.-)%s+loot%s*bag%s*$",
"^рюкзак%s+(.+)%s*$", 
"^Рюкзак%s+(.+)%s*$", 
"^РЮКЗАК%s+(.+)%s*$", 
"^сумка%s+(.+)%s*$", 
"^Сумка%s+(.+)%s*$",
"^СУМКА%s+(.+)%s*$",
"^мешок%s+(.+)%s*$", 
"^Мешок%s+(.+)%s*$",
"^МЕШОК%s+(.+)%s*$",
"^труп%s+(.+)%s*$", 
"^Труп%s+(.+)%s*$",
"^ТРУП%s+(.+)%s*$",
}
for _, p in ipairs(pats) do
