if not pg then
return
end
local okG, guis = pcall(function()
return pg:GetChildren()
end)
if not okG or type(guis) ~= "table" then
return
end
for _, gui in ipairs(guis) do
if gui:IsA("LayerCollector") then
local nameL = string.lower(tostring(gui.Name))
if not string.find(nameL, "petuh", 1, true) then
bpCaptureBagGui(gui)
end
end
end
end
function bpReadInfo(inst, deep) 
local owner
local slotsUsed, slotsMax, itemCount
local cached = bpOpenCacheInst[inst]
if cached and os.clock() - (cached.At or 0) > BP_OPEN_TTL then
cached = nil
bpOpenCacheInst[inst] = nil
end
if cached then
if owner == nil then
owner = cached.Owner
end
if slotsUsed == nil and cached.Slots then
local cu, cm = string.match(cached.Slots, "(%d+)%s*/%s*(%d+)")
if cu and cm then
slotsUsed = tonumber(cu)
slotsMax = tonumber(cm)
else
slotsUsed = tonumber(cached.Slots)
end
end
end
local okA, attrs = pcall(function()
return inst:GetAttributes()
end)
if okA and type(attrs) == "table" then
for key, val in pairs(attrs) do
local keyL = string.lower(tostring(key))
if owner == nil and type(val) == "string" and #val > 0 and #val <= 32
and table.find(BP_OWNER_ATTRS, keyL) then
owner = val
end
if owner == nil and type(val) == "number"
and table.find(BP_OWNERID_ATTRS, keyL) then
local okP, plr = pcall(Players.GetPlayerByUserId, Players, val)
if okP and plr then
owner = plr.Name
end
end
if type(val) == "number" then
if slotsUsed == nil and table.find(BP_USED_ATTRS, keyL) then
slotsUsed = val
end
if slotsMax == nil and table.find(BP_MAX_ATTRS, keyL) then
slotsMax = val
end
end
end
end
local okC, children = pcall(function()
return inst:GetChildren()
end)
if okC and type(children) == "table" then
for _, ch in ipairs(children) do
local nameL = string.lower(tostring(ch.Name))
if ch:IsA("StringValue") then
if owner == nil and table.find(BP_OWNER_VALUE_NAMES, nameL)
and type(ch.Value) == "string" and #ch.Value > 0 and #ch.Value <= 32 then
owner = ch.Value
end
elseif ch:IsA("ObjectValue") then
if owner == nil and table.find(BP_OWNER_VALUE_NAMES, nameL)
and typeof(ch.Value) == "Instance" then
local okV, vName = pcall(function()
return tostring(ch.Value.Name)
end)
if okV then
owner = vName
end
end
elseif ch:IsA("IntValue") or ch:IsA("NumberValue") then
local v = tonumber(ch.Value)
if v then
if slotsUsed == nil and nameL ~= "slots" and table.find(BP_USED_ATTRS, nameL) then
slotsUsed = v
end
if slotsMax == nil and table.find(BP_MAX_ATTRS, nameL) then
slotsMax = v
end
end
end
end
end
local okP, prompt = pcall(function()
return inst:FindFirstChildOfClass("ProximityPrompt")
end)
if okP and prompt then
if owner == nil then
local okT, title = pcall(function()
return tostring(prompt.ObjectText)
end)
if okT and title and #title > 0 and #title <= 48 then
local titleL = string.lower(title)
for _, plr in ipairs(Players:GetPlayers()) do
local nL = string.lower(plr.Name)
local dL = string.lower(plr.DisplayName)
if string.find(titleL, nL, 1, true)
or (dL ~= nL and #dL > 2 and string.find(titleL, dL, 1, true)) then
owner = plr.Name
break
end
end
if owner == nil then
owner = bpOwnerFromLabel(title)
end
if owner == nil then
local cleaned = tostring(title)
local stripWords = {
"РЮКЗАК", "Рюкзак", "рюкзак", "BACKPACK", "Backpack", "backpack",
"СУМКА", "Сумка", "сумка", "МЕШОК", "Мешок", "мешок",
"ТРУП", "Труп", "труп", "CORPSE", "Corpse", "corpse",
"LOOT", "Loot", "loot", "BAG", "Bag", "bag",
"МАЛЕНЬКИЙ", "Маленький", "маленький",
"БОЛЬШОЙ", "Большой", "большой", "СРЕДНИЙ", "Средний", "средний",
"ОБЫЧНЫЙ", "Обычный", "обычный", "ОГРОМНЫЙ", "Огромный", "огромный",
"ПУСТОЙ", "Пустой", "пустой",
"SMALL", "Small", "small", "BIG", "Big", "big",
"MEDIUM", "Medium", "medium", "LARGE", "Large", "large",
"HUGE", "Huge", "huge", "COMMON", "Common", "common",
}
for _, w in ipairs(stripWords) do
cleaned = cleaned:gsub(w, "")
end
cleaned = cleaned:gsub("^[%s%p]+", ""):gsub("[%s%p]+$", "")
if #cleaned >= 3 then
owner = cleaned
end
end
end
end
if slotsUsed == nil then
local okAc, actText = pcall(function()
return tostring(prompt.ActionText)
end)
if okAc and actText then
local uAct, mAct = string.match(actText, "%((%d+)%s*/%s*(%d+)%)")
if uAct and mAct then
slotsUsed = tonumber(uAct)
slotsMax = tonumber(mAct)
end
local num = string.match(actText, "%((%d+)%)")
or string.match(actText, "%[(%d+)%]")
or string.match(actText, "(%d+)")
if num then
slotsUsed = tonumber(num)
end
end
end
end
if deep and (owner == nil or slotsUsed == nil) then
local okDesc, desc = pcall(function()
return inst:GetDescendants()
end)
if okDesc and type(desc) == "table" then
local scanned = 0
for _, ch in ipairs(desc) do
scanned = scanned + 1
if scanned > 80 then
break 
end
if owner == nil or slotsUsed == nil then
pcall(function()
for key, val in pairs(ch:GetAttributes()) do
local keyL = string.lower(tostring(key))
if owner == nil and type(val) == "string" and #val > 0 and #val <= 32
and table.find(BP_OWNER_ATTRS, keyL) then
owner = val
end
if owner == nil and type(val) == "number"
and table.find(BP_OWNERID_ATTRS, keyL) then
local okP3, plr3 = pcall(Players.GetPlayerByUserId, Players, val)
if okP3 and plr3 then
owner = plr3.Name
end
end
if type(val) == "number" then
if slotsUsed == nil and table.find(BP_USED_ATTRS, keyL) then
slotsUsed = val
end
if slotsMax == nil and table.find(BP_MAX_ATTRS, keyL) then
slotsMax = val
end
end
end
end)
end
if ch:IsA("ProximityPrompt") and (owner == nil or slotsUsed == nil) then
pcall(function()
if owner == nil then
owner = bpOwnerFromLabel(tostring(ch.ObjectText))
end
if slotsUsed == nil then
local prTxt = tostring(ch.ObjectText) .. " " .. tostring(ch.ActionText)
local uPr, mPr = string.match(prTxt, "(%d+)%s*/%s*(%d+)")
if uPr and mPr then
slotsUsed = tonumber(uPr)
slotsMax = tonumber(mPr)
end
end
end)
end
if ch:IsA("TextLabel") or ch:IsA("TextButton") then
local okTx, txt = pcall(function()
return tostring(ch.Text)
end)
if okTx and txt and #txt > 0 and #txt <= 80 then
local txtL = string.lower(txt)
if slotsUsed == nil then
local isTimer = string.find(txtL, "счез", 1, true)
or string.find(txtL, "ерез", 1, true)
or string.find(txtL, "xpire", 1, true)
or string.find(txtL, "espawn", 1, true)
or string.find(txtL, "lapse", 1, true)
if not isTimer then
local uTxt, mTxt = string.match(txt, "(%d+)%s*/%s*(%d+)")
if uTxt and mTxt then
slotsUsed = tonumber(uTxt)
slotsMax = tonumber(mTxt)
end
end
end
if owner == nil then
for _, plr in ipairs(Players:GetPlayers()) do
local nL = string.lower(plr.Name)
local dL = string.lower(plr.DisplayName)
if string.find(txtL, nL, 1, true)
or (dL ~= nL and #dL > 2 and string.find(txtL, dL, 1, true)) then
owner = plr.Name
break
end
end
end
if owner == nil then
owner = bpOwnerFromLabel(txt)
end
end
end
if owner and slotsUsed then
break 
end
end
end
end
if owner == nil then
local okN9, nm9 = pcall(function()
return tostring(inst.Name)
end)
if okN9 and nm9 then
local rec9 = bpOpenCacheTitle[string.lower(nm9)]
if rec9 and os.clock() - (rec9.At or 0) <= BP_OPEN_TTL then
owner = rec9.Owner
end
end
end
if owner == nil then
local nameL = bpNameLower(inst)
if #nameL > 0 then
for _, plr in ipairs(Players:GetPlayers()) do
if string.find(nameL, string.lower(plr.Name), 1, true) then
owner = plr.Name
break
end
end
end
if owner == nil then
owner = bpOwnerFromLabel(tostring(inst.Name))
end
end
if slotsUsed == nil and okC and type(children) == "table" then
for _, ch in ipairs(children) do
if ch:IsA("Folder") or ch:IsA("Model") then
local nameL = string.lower(tostring(ch.Name))
if bpMatchesFragments(nameL, BP_SLOT_FOLDERS) then
local cnt = 0
local okI, items = pcall(function()
return ch:GetChildren()
end)
if okI and type(items) == "table" then
for _, item in ipairs(items) do
if item:IsA("Tool") or item:IsA("Model") or item:IsA("BasePart")
or item:IsA("IntValue") or item:IsA("NumberValue")
or item:IsA("StringValue") then
cnt = cnt + 1
end
end
end
if cnt > 0 then
itemCount = math.max(itemCount or 0, cnt)
end
end
end
end
local tools = 0
for _, ch in ipairs(children) do
if ch:IsA("Tool") then
tools = tools + 1
end
end
if tools > 0 then
itemCount = math.max(itemCount or 0, tools)
end
end
local slotsText
if slotsUsed and slotsMax and slotsMax > 0 then
slotsText = string.format("%d/%d", math.floor(slotsUsed), math.floor(slotsMax))
elseif slotsUsed then
slotsText = string.format("%d слот.", math.floor(slotsUsed))
elseif slotsMax and slotsMax > 0 then
slotsText = string.format("?/%d", math.floor(slotsMax))
elseif itemCount then
slotsText = tostring(itemCount) .. " предм."
end
return { Owner = owner, Slots = slotsText }
end
-- 0.50: старые заглушки фрикама удалены (чистка кода) — движок
-- вернулся и объявлен выше (universal_freecam_v13): freecamEnable и
-- freecamDisable теперь настоящие, FreeCam.Enabled синхронизируется.
LOOT_POOL_SIZE = 12
LOOT_POOL_INTERVAL = 1.2 -- 0.39: было 0.35 — лагало на ПК. 1.2с достаточно.
lootChamPool = {}
lootChamPoolAt = 0
lootChamPoolBlocked = false
lootChamPoolWanted = nil 
function lootPoolDisableAll()
for _, h in ipairs(lootChamPool) do
pcall(function()
h.Enabled = false
h.Adornee = nil
end)
end
lootChamPoolWanted = nil
end
function lootPoolCleanup()
for i = 1, #lootChamPool do
pcall(function()
lootChamPool[i]:Destroy()
end)
lootChamPool[i] = nil
end
lootChamPoolWanted = nil
end
function lootPoolContains(inst)
for _, h in ipairs(lootChamPool) do
if h.Adornee == inst and h.Enabled then
return true
end
end
return false
end
function lootPoolUpdate(myRoot, now)
local bagOn = S.Loot.Enabled and S.Loot.Chams
local contOn = S.LootC.Enabled and S.LootC.Chams
local wanted = (bagOn or contOn) and not lootChamPoolBlocked
if not wanted then
if lootChamPoolWanted ~= false then
lootPoolDisableAll()
lootChamPoolWanted = false
end
return
end
if now - lootChamPoolAt < LOOT_POOL_INTERVAL then
return
end
lootChamPoolAt = now
local list = {}
for inst, e in pairs(trackedBackpacks) do
if inst.Parent and inst:IsDescendantOf(Workspace) then
local cat = e.Cat or "bag"
local catOn = (cat == "bag" and bagOn) or (cat == "cont" and contOn)
if catOn then
local okD, d = pcall(function()
return (inst:GetPivot().Position - myRoot.Position).Magnitude
end)
if okD and d then
local maxD = (cat == "bag") and S.Loot.MaxDistance or S.LootC.MaxDistance
if d <= maxD * 1.06 + 10 then
table.insert(list, { inst = inst, d = d, cat = cat })
end
end
end
end
end
if #list > 1 then
table.sort(list, function(a, b)
return a.d < b.d
end)
end
local used = 0
for i = 1, math.min(#list, LOOT_POOL_SIZE) do
local item = list[i]
local h = lootChamPool[used + 1]
if not h then
local okH, created = pcall(function()
local nh = Instance.new("Highlight")
nh.Name = "PETUH_LootChamPool"
nh.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
nh.FillTransparency = 0.45
nh.OutlineTransparency = 0
nh.Parent = Workspace
return nh
end)
if okH and created then
h = created
lootChamPool[used + 1] = created
else
lootChamPoolBlocked = true
warn("[FUST] Пул чамсов лута недоступен — откат на квадраты-заливки")
break
end
end
used = used + 1
pcall(function()
h.Adornee = item.inst
h.FillColor = (item.cat == "bag") and LOOT_COLOR or LOOTC_COLOR
h.OutlineColor = (item.cat == "bag") and LOOT_COLOR or LOOTC_COLOR
h.Enabled = true
end)
