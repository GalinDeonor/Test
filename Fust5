function bpScanContainer(root, maxDepth)
local function walk(parent, depth)
if depth > maxDepth then
return
end
local okC, kids = pcall(function()
return parent:GetChildren()
end)
if not okC or type(kids) ~= "table" then
return
end
for _, ch in ipairs(kids) do
if ch:IsA("Model") or ch:IsA("BasePart") then
bpTryTrack(ch)
end
if ch:IsA("Folder") or (ch:IsA("Model") and depth < 2) then
walk(ch, depth + 1)
end
end
end
walk(root, 1)
end
