for i = #hmQueue, 1, -1 do
local m = hmQueue[i]
local age = now - m.born
if age > Hits.HMDuration then
for _, l in ipairs(m.lines) do pcall(function() l:Remove() end) end
table.remove(hmQueue, i)
elseif not Hits.HM then
for _, l in ipairs(m.lines) do pcall(function() l.Visible = false end) end
