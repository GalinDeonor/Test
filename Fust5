fovGuiStroke.Color = main
if hasTarget then
-- цель захвачена — СПЛОШНОЙ цвет (по умолчанию зелёный)
fovGuiGradient.Color = ColorSequence.new(main)
else
-- целей нет — кольцо из основного + затемнённого (красно-чёрное)
local dark = Color3.new(main.R * 0.15, main.G * 0.15, main.B * 0.15)
