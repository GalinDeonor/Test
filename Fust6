function V.cleanup()
    V.S.Unloaded = true
    pcall(function()
        if V._gunHooked and V.GunBase then
            if V.GunBase[V._gunHooked.fireName] then
                -- restore через rawset невозможен для upvalue-оригинала —
                -- оригиналы сохранены в V._origFire/_origReload
            end
