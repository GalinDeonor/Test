pcall(function()
-- Проверяем только если игра дала плейс-специфичную группу
local placeGroup = nil
pcall(function()
-- FUST: пробуем common survival group IDs
for _, gid in ipairs({ 0 }) do
-- placeholder: реальный group ID нужно узнать из игры
end
end)
end)
end
end
end
