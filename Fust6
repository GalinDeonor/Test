-- выстрелы: hookmetamethod __namecall ловит Raycast у Workspace, луч длиннее
-- 50 стадов и не дальше 5 м от камеры = чей-то выстрел вплотную к тебе
-- (практически всегда — твой). Старый детектор «быстрая часть + прямая»
-- СПАМИЛ: считал пулями любые летящие части, в т.ч. от бегущих игроков и
-- тимейтов — УДАЛЁН. Пул Beam'ов VOMAGLA: Part + 2 Attachment + Beam
-- (FaceCamera, LightEmission 1, TextureLength/Speed 2).
local btPool, btPoolSize = {}, 0
local btActive = {}
local function btGet()
if btPoolSize > 0 then
local p = btPool[btPoolSize]
btPool[btPoolSize] = nil
btPoolSize = btPoolSize - 1
return p
end
local p = Instance.new("Part")
p.Anchored = true
p.CanCollide = false
p.Transparency = 1
p.Size = Vector3.new(0.1, 0.1, 0.1)
local a0 = Instance.new("Attachment", p)
a0.Name = "A0"
local a1 = Instance.new("Attachment", p)
a1.Name = "A1"
local b = Instance.new("Beam")
b.Name = "B"
b.Attachment0 = a0
b.Attachment1 = a1
b.FaceCamera = true
b.LightEmission = 1
b.LightInfluence = 0
b.TextureLength = 2
b.TextureSpeed = 2
b.Parent = p
return p
end
local function btRelease(p, b)
if b then
b.Enabled = false
end
if p then
p.Parent = nil
btPoolSize = btPoolSize + 1
btPool[btPoolSize] = p
end
end
function btDestroyAll()
for i = #btActive, 1, -1 do
local t = btActive[i]
if t and t.p then
pcall(function() t.p:Destroy() end)
end
btActive[i] = nil
end
for i = 1, btPoolSize do
pcall(function() btPool[i]:Destroy() end)
end
btPool = {}
btPoolSize = 0
end
