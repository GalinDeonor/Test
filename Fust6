-- При старте проверяет: прошлый запуск закончился abruptly? Если да —
-- в начале лога пометка "PREVIOUS RUN: ABRUPT EXIT".
-- ============================================================================

KICKLOG_FILE = "FUST_kicks.log"
KICKLOG_MAX  = 262144
KICKLOG_FLAG = "FUST_KL_Active"  -- маркер активной сессии в логе

local function klAppend(msg)
if type(appendfile) ~= "function" then return end
pcall(function()
appendfile(KICKLOG_FILE, msg .. "\n")
end)
end

local function klRead()
if type(isfile) ~= "function" or not isfile(KICKLOG_FILE) then return "" end
local ok, c = pcall(readfile, KICKLOG_FILE)
return ok and c or ""
end

local function klRotateIfNeeded()
pcall(function()
if type(isfile) == "function" and isfile(KICKLOG_FILE) then
local okS, sz = pcall(function() return #readfile(KICKLOG_FILE) end)
if okS and sz and sz > KICKLOG_MAX then
writefile(KICKLOG_FILE, "")
end
end
end)
end

local function klTimestamp()
local okD, s = pcall(os.date, "%Y-%m-%d %H:%M:%S")
return okD and s or tostring(os.time())
end

