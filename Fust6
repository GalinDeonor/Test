-- Поиск кик-баннера в CoreGui: Roblox при Player:Kick(reason) показывает
-- TextLabel с причиной в CoreGui.RobloxPromptDialog или подобных. Сканируем
-- первые N TextLabel-ов с непустым текстом.
local function klScanKickBanner()
local found = nil
pcall(function()
local promptRoot
pcall(function()
promptRoot = game:GetService("CoreGui"):FindFirstChild("RobloxPromptDialog")
end)
if not promptRoot then
pcall(function()
for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
if gui:IsA("ScreenGui") then
local p = gui:FindFirstChild("PromptDialog") or gui:FindFirstChild("RobloxPromptDialog")
or gui:FindFirstChildWhichIsA("Frame")
if p then promptRoot = p break end
end
end
end)
end
if promptRoot then
local scanned = 0
for _, desc in ipairs(promptRoot:GetDescendants()) do
scanned = scanned + 1
if scanned > 60 then break end
if desc:IsA("TextLabel") and desc.Text and #desc.Text > 3 then
local t = desc.Text
if t:lower():find("kick") or t:lower():find("ban")
or t:lower():find("вы kicked") or t:lower():find("вы ban")
or t:lower():find("обнаружен") or t:lower():find("detect")
or t:lower():find("cheat") or t:lower():find("чит")
or t:lower():find("exploit") or t:lower():find("hack")
or t:lower():find("разблокирован") or t:lower():find("нарушен") then
found = t
break
end
end
end
end
end)
return found
end

