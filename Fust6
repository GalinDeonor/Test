-- Снимок состояния чита (что было включено) — по UIRegistry/Set-флагам
local function klSnapshotFeatures()
local lines = {}
-- Источник 1: Library.Flags (если есть)
local lib = getgenv().Library
local flags = lib and lib.Flags
if type(flags) == "table" then
for _, k in ipairs(KL_INTERESTING) do
local v = flags[k]
if v ~= nil then
table.insert(lines, "  " .. k .. " = " .. tostring(v))
end
end
end
-- Источник 2: прямые стейты (S, Aim, Evil, AutoAim) — дублирует, но надёжнее
pcall(function()
if type(S) == "table" then
if S.Hitbox then
table.insert(lines, "  [state] S.Hitbox.Enabled=" .. tostring(S.Hitbox.Enabled) .. " Size=" .. tostring(S.Hitbox.Size))
end
if S.ESP then
table.insert(lines, "  [state] S.ESP.Enabled=" .. tostring(S.ESP.Enabled) .. " Box=" .. tostring(S.ESP.Box) .. " Chams=" .. tostring(S.ESP.Chams))
end
if S.NPC then
table.insert(lines, "  [state] S.NPC.ESP=" .. tostring(S.NPC.ESP) .. " Hitbox=" .. tostring(S.NPC.HitboxEnabled) .. " Size=" .. tostring(S.NPC.HitboxSize))
end
end
if type(Aim) == "table" then
table.insert(lines, "  [state] Aim.Enabled=" .. tostring(Aim.Enabled) .. " FOV=" .. tostring(Aim.FOV) .. " Smooth=" .. tostring(Aim.Smooth) .. " WallCheck=" .. tostring(Aim.WallCheck))
end
if type(Evil) == "table" then
table.insert(lines, "  [state] Evil.Enabled=" .. tostring(Evil.Enabled) .. " AutoPred=" .. tostring(Evil.AutoPred) .. " Snipe=" .. tostring(Evil.Snipe) .. " K=" .. tostring(Evil.K))
end
if type(AutoAim) == "table" then
table.insert(lines, "  [state] AutoAim.Enabled=" .. tostring(AutoAim.Enabled) .. " Radius=" .. tostring(AutoAim.Radius))
end
if type(FreeCam) == "table" then
table.insert(lines, "  [state] FreeCam.Enabled=" .. tostring(FreeCam.Enabled) .. " Speed=" .. tostring(FreeCam.Speed))
end
end)
if #lines == 0 then
return "  (состояние недоступно)"
end
return table.concat(lines, "\n")
end

-- Поиск кик-баннера в CoreGui: Roblox при Player:Kick(reason) показывает
-- TextLabel с причиной в CoreGui.RobloxPromptDialog или подобных. Сканируем
-- первые N TextLabel-ов с непустым текстом.
local function klScanKickBanner()
local found = nil
pcall(function()
local promptRoot
pcall(function()
promptRoot = game:GetService("CoreGui"):FindFirstChild("RobloxPromptDialog")
end)
if not promptRoot then
pcall(function()
for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
if gui:IsA("ScreenGui") then
local p = gui:FindFirstChild("PromptDialog") or gui:FindFirstChild("RobloxPromptDialog")
or gui:FindFirstChildWhichIsA("Frame")
if p then promptRoot = p break end
end
end
end)
end
if promptRoot then
local scanned = 0
for _, desc in ipairs(promptRoot:GetDescendants()) do
scanned = scanned + 1
if scanned > 60 then break end
if desc:IsA("TextLabel") and desc.Text and #desc.Text > 3 then
local t = desc.Text
if t:lower():find("kick") or t:lower():find("ban")
or t:lower():find("вы kicked") or t:lower():find("вы ban")
or t:lower():find("обнаружен") or t:lower():find("detect")
or t:lower():find("cheat") or t:lower():find("чит")
or t:lower():find("exploit") or t:lower():find("hack")
or t:lower():find("разблокирован") or t:lower():find("нарушен") then
found = t
break
end
end
end
end
end)
return found
end

-- Главная функция: записать вылет
local function klLogExit(reason, extraText)
pcall(function()
klRotateIfNeeded()
local ts = klTimestamp()
local placeId, placeName, jobId = klPlaceInfo()
local exec = tostring(EXECUTOR_NAME or "неизвестен")
local snap = klSnapshotFeatures()
local banner = extraText or klScanKickBanner()
local entry = {}
table.insert(entry, "==========================================================")
table.insert(entry, "[" .. ts .. "] " .. reason)
table.insert(entry, "  Place:    " .. placeId .. " (" .. placeName .. ")")
table.insert(entry, "  JobId:    " .. jobId)
table.insert(entry, "  Executor: " .. exec)
if banner then
table.insert(entry, "  KickMsg:  " .. banner)
end
table.insert(entry, "  --- Active features at exit ---")
table.insert(entry, snap)
table.insert(entry, "==========================================================")
local msg = table.concat(entry, "\n")
klAppend(msg)
print("[FUST-KL] " .. msg)
warn("[FUST-KL] ВЫЛЕТ ЗАЛОГИРОВАН: " .. KICKLOG_FILE .. " — скинь скрин консоли.")
end)
end

-- Стартовая проверка: прошлый запуск abruptly завершился?
local function klCheckPreviousRun()
pcall(function()
local log = klRead()
if #log == 0 then return end
-- Ищем последнюю запись "ЗАПУСК" / START и DEACTIVATED.
-- Luau не любит \[ в обычных строках — используем long-string + % escape.
local lastStart = log:match([[.-%[(.-)%] === ЗАПУСК 0%.39]])
or log:match([[.-%[(.-)%] FUST_KL_Active_START]])
local lastDeactivate = log:match([[.-%[(.-)%] FUST_KL_DEACTIVATED]])
if lastStart and not lastDeactivate then
-- Прошлый запуск не завершился нормально → abrupt exit
local ts = klTimestamp()
local placeId, placeName, jobId = klPlaceInfo()
local exec = tostring(EXECUTOR_NAME or "неизвестен")
local msg = "==========================================================\n"
.. "[" .. ts .. "] PREVIOUS RUN: ABRUPT EXIT\n"
.. "  Предыдущий запуск (начат " .. (lastStart or "?") .. ") НЕ завершился\n"
.. "  нормальной деактивацией — возможный КИК/БАН во время игры.\n"
.. "  Place:    " .. placeId .. " (" .. placeName .. ")\n"
.. "  JobId:    " .. jobId .. "\n"
.. "  Executor: " .. exec .. "\n"
.. "  Смотри последнюю запись 'ВЫЛЕТ' выше для деталей.\n"
.. "=========================================================="
klAppend(msg)
print("[FUST-KL] PREVIOUS RUN: ABRUPT EXIT — смотри " .. KICKLOG_FILE)
end
end)
end

-- Хук на FUST_Deactivate: пишем маркер нормального выхода
local origDeactivate = getgenv().FUST_Deactivate
getgenv().FUST_Deactivate = function(...)
pcall(function()
local ts = klTimestamp()
klAppend("[" .. ts .. "] FUST_KL_DEACTIVATED — нормальный выход через кнопку.")
end)
if type(origDeactivate) == "function" then
return origDeactivate(...)
end
end

