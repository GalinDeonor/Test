function adminScanTick()
local found = {}
for _, plr in ipairs(Players:GetPlayers()) do
if plr ~= LocalPlayer then
local isAdm = false
-- 1. Roblox admin badge (UserId < 1000 = старый акк, не админ; проверяем HasBadge)
pcall(function()
if plr.UserId < 1000 then
isAdm = true
table.insert(found, plr.Name .. " (Roblox staff)")
end
end)
-- 2. Атрибуты игрока
if not isAdm then
pcall(function()
local attrs = plr:GetAttributes()
for k, v in pairs(attrs) do
local kl = string.lower(tostring(k))
for _, attr in ipairs(ADMIN_ATTRS) do
if kl == string.lower(attr) and v then
isAdm = true
table.insert(found, plr.Name .. " (attr:" .. k .. ")")
break
end
end
end
end)
end
-- 3. CollectionService теги
if not isAdm then
pcall(function()
for _, tag in ipairs(ADMIN_TAGS) do
if CollectionService:HasTag(plr, tag) then
isAdm = true
table.insert(found, plr.Name .. " (tag:" .. tag .. ")")
break
end
end
end)
end
-- 4. FUST-специфичные теги/атрибуты на Character
if not isAdm then
pcall(function()
local c = plr.Character
if c then
for _, tag in ipairs({ "FustAdmin", "FustMod", "Admin", "Moderator" }) do
if CollectionService:HasTag(c, tag) then
isAdm = true
table.insert(found, plr.Name .. " (char:" .. tag .. ")")
break
end
end
end
end)
end
-- 5. GroupRole — если у игрока роль Owner/Admin/Moderator в какой-то группе
